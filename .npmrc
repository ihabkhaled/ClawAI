# Workspace-wide npm config.
#
# legacy-peer-deps=true is required because the monorepo intentionally
# uses TypeScript prereleases (root: typescript@^6.0.0-beta, chat-service +
# llamacpp-service: typescript@npm:@typescript/native-preview@beta which
# resolves to a 7.0.0-dev.* prerelease) AND @eslint/js@10 (which requires
# eslint@^10 as peer, but the rest of the toolchain — most importantly
# eslint-plugin-import inside eslint-config-next — still caps at eslint@^9).
#
# Modern peerOptional resolution in npm 10+ is strict on prerelease semver
# matching, so packages that declare `peerOptional typescript@">=5.4.0"`
# (e.g. @prisma/client@7) reject our prerelease typescript even though it
# is effectively newer. Without this flag, install fails with ERESOLVE on
# multiple unrelated packages.
#
# This is the npm-documented workaround for hybrid prerelease setups
# (https://docs.npmjs.com/cli/v10/using-npm/config#legacy-peer-deps), not
# a workaround for genuinely incompatible deps. Every conflict this
# resolves is a prerelease/peer-version-string quirk, not a real API gap.
legacy-peer-deps=true

# Always include optional dependency metadata in the lockfile, even for
# platforms we can't install on. Without this, `npm install` on Windows
# strips Linux/macOS/Android native binding entries (lightningcss-*,
# @rolldown/binding-*, fsevents) from package-lock.json, and CI's
# `npm ci` on Linux then dies with EUSAGE "Missing X from lock file".
include=optional

{
  "name": "@claw/shared-constants",
  "version": "1.223.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "lint": "eslint src/ --concurrency=4 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc/core": "^1.16.20",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "78.0.0",
    "tsc-alias": "^1.9.9",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}

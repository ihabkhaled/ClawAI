{
  "name": "@claw/shared-rabbitmq",
  "version": "1.216.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "lint": "eslint src/ --concurrency=1 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@claw/shared-constants": "*",
    "@claw/shared-types": "*",
    "amqplib": "^2.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@swc/core": "^1.16.18",
    "@types/amqplib": "^0.10.8",
    "babel-plugin-transform-import-meta": "^3.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-unicorn": "77.0.0",
    "tsc-alias": "^1.9.7",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}

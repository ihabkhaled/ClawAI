    "eslint": "^10.11.0",
    "eslint-plugin-unicorn": "76.0.0",
    "tsc-alias": "^1.9.5",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.2"
  },
  "type": "module"

{
  "name": "@claw/shared-utilities",
  "version": "1.23.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    }
  },
  "scripts": {
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/ --concurrency=1",
    "lint:fix": "eslint src/ --fix",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@claw/shared-constants": "1.23.0",
    "@claw/shared-types": "1.23.0",
    "@nestjs/common": "^11.1.28",
    "axios": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-unicorn": "73.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}

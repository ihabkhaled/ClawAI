{
  "name": "@claw/shared-utilities",
  "version": "1.138.4",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./connector-presets": {
      "types": "./dist/connector-presets/index.d.ts",
      "default": "./dist/connector-presets/index.js"
    }
  },
  "scripts": {
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/ --concurrency=1",
    "lint:fix": "eslint src/ --fix",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@claw/shared-constants": "1.138.4",
    "@claw/shared-types": "1.138.4",
    "@nestjs/common": "^12.0.3",
    "axios": "^1.20.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc/core": "^1.16.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-unicorn": "75.0.0",
    "tsc-alias": "^1.9.5",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "5.0.1"
  },
  "type": "module"
}

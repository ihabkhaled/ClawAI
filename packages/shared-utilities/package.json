{
  "name": "@claw/shared-utilities",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsgo -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/ --concurrency=4",
    "lint:fix": "eslint src/ --fix",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@claw/shared-constants": "1.0.0",
    "@claw/shared-types": "1.0.0",
    "@nestjs/common": "^11.1.26",
    "axios": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^7.0.12",
    "@typescript/native-preview": "^7.0.0-dev.20260607.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}

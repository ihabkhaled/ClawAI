{
  "name": "@claw/shared-utilities",
  "version": "1.79.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    }
  },
  "scripts": {
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/ --concurrency=1",
    "lint:fix": "eslint src/ --fix",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@claw/shared-constants": "1.79.0",
    "@claw/shared-types": "1.79.0",
    "@nestjs/common": "^12.0.1",
    "axios": "^1.20.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "babel-jest": "^30.5.1",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-unicorn": "74.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.4",
    "typescript": "^6.0.3"
  },
  "type": "module"
}

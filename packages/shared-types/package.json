{
  "name": "@claw/shared-types",
  "version": "1.195.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "lint": "eslint src/ --concurrency=1",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc/core": "^1.16.13",
    "eslint": "^10.12.0",
    "eslint-plugin-unicorn": "76.0.0",
    "tsc-alias": "^1.9.7",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}

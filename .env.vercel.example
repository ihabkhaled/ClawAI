# =============================================================================
# ClawAI — Vercel deployment environment template
# =============================================================================
#
#   cp .env.vercel.example .env.vercel
#   # fill in the values below
#   npm run vercel:validate
#
# .env.vercel is gitignored. NEVER commit real values into this template.
# Every value here is consumed by scripts/vercel/*.mjs and uploaded to the
# matching Vercel projects per deploy/vercel/environment.json — each project
# receives only the variables it actually reads.
#
# This file is for the DEPLOYMENT AUTOMATION. It is not the runtime .env used
# by docker compose; see .env.example for that.
# =============================================================================


# -----------------------------------------------------------------------------
# Vercel account
# -----------------------------------------------------------------------------
# Personal access token with project create + deploy scope.
# Create at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Team (org) id. Leave empty to use the token owner's personal scope.
VERCEL_TEAM_ID=
# The single GitHub repository every Vercel project is linked to.
VERCEL_GIT_REPOSITORY=ihabkhaled/ClawAI
# Branch that publishes to production.
VERCEL_PRODUCTION_BRANCH=main


# -----------------------------------------------------------------------------
# Shared security
# -----------------------------------------------------------------------------
# HS256 JWT signing secret. Minimum 32 characters. Must be byte-identical across
# every backend project or tokens issued by auth-service will not verify.
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM key: exactly 64 hex characters. Encrypts connector API keys,
# workspace OAuth tokens, and research provider credentials. Rotating this makes
# all existing ciphertext unreadable.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Shared bearer for `Authorization: Service <token>` inter-service calls.
# Minimum 32 characters.
#   openssl rand -base64 32
INTER_SERVICE_AUTH_TOKEN=

# Bootstrap admin, seeded by auth-service on first boot only.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Leave these empty on a first deploy — scripts/vercel/resolve-service-urls.mjs
# fills them from the live Vercel URLs. Set them only to pin a custom domain.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=ClawAI
# Preview only. Never enable in production.
NEXT_PUBLIC_ROUTING_DEBUG_CONTEXT_INSPECTOR_ENABLED=false

# Comma-separated browser origins each backend will accept. Must include the
# frontend production URL (and the preview URL for preview deployments).
CORS_ORIGINS=


# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
# Normally left EMPTY. `npm run vercel:resolve-urls -- --target production --sync`
# discovers each project's live URL and pushes it to the projects that call it.
# Fill one in only to pin a custom domain for that service.
#
# Never point these at Docker hostnames (auth-service:4001) or localhost —
# scripts/vercel/validate.mjs fails a production run that does.
AUTH_SERVICE_URL=
CHAT_SERVICE_URL=
CONNECTOR_SERVICE_URL=
ROUTING_SERVICE_URL=
MEMORY_SERVICE_URL=
FILE_SERVICE_URL=
AUDIT_SERVICE_URL=
HEALTH_SERVICE_URL=
CLIENT_LOGS_SERVICE_URL=
SERVER_LOGS_SERVICE_URL=
IMAGE_SERVICE_URL=
FILE_GENERATION_SERVICE_URL=
WORKSPACE_SERVICE_URL=
AGENT_SERVICE_URL=
RESEARCH_SERVICE_URL=


# -----------------------------------------------------------------------------
# PostgreSQL databases
# -----------------------------------------------------------------------------
# Each service owns its own database — never point two services at the same one
# (scripts/vercel/validate.mjs enforces this).
#
# *_DATABASE_URL        pooled connection, used at runtime by the function.
# *_DIRECT_DATABASE_URL direct (non-pooled) connection, used ONLY by migrations.
#                       Prisma advisory locks do not survive a connection pooler.
#
# On Neon: the pooled host contains "-pooler", the direct host does not.

AUTH_DATABASE_URL=
AUTH_DIRECT_DATABASE_URL=

CHAT_DATABASE_URL=
CHAT_DIRECT_DATABASE_URL=

CONNECTOR_DATABASE_URL=
CONNECTOR_DIRECT_DATABASE_URL=

ROUTING_DATABASE_URL=
ROUTING_DIRECT_DATABASE_URL=

# The memory database REQUIRES the pgvector extension.
MEMORY_DATABASE_URL=
MEMORY_DIRECT_DATABASE_URL=

FILES_DATABASE_URL=
FILES_DIRECT_DATABASE_URL=

IMAGE_DATABASE_URL=
IMAGE_DIRECT_DATABASE_URL=

FILE_GENERATION_DATABASE_URL=
FILE_GENERATION_DIRECT_DATABASE_URL=

WORKSPACE_DATABASE_URL=
WORKSPACE_DIRECT_DATABASE_URL=

AGENT_DATABASE_URL=
AGENT_DIRECT_DATABASE_URL=

RESEARCH_DATABASE_URL=
RESEARCH_DIRECT_DATABASE_URL=


# -----------------------------------------------------------------------------
# MongoDB databases
# -----------------------------------------------------------------------------
# Separate databases (an Atlas cluster may host all three). TTL indexes for the
# two log stores are created by `npm run vercel:migrate`.
AUDIT_MONGODB_URL=
CLIENT_LOGS_MONGODB_URL=
SERVER_LOGS_MONGODB_URL=


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Use a serverless-friendly provider (Upstash). A classic single-node Redis will
# exhaust its connection limit under per-invocation serverless connections.
REDIS_URL=


# -----------------------------------------------------------------------------
# Queue provider
# -----------------------------------------------------------------------------
# AMQP endpoint for the claw.events topic exchange (e.g. CloudAMQP).
# Publishing works from a Vercel function. Durable CONSUMPTION does not — a
# serverless function is not running when no request is in flight. Until an
# HTTPS-push queue is wired up, audit-service and server-logs-service only
# record what reaches them over direct HTTP. See the docs for the trade-off.
RABBITMQ_URL=


# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# The Vercel filesystem is ephemeral and read-only outside /tmp. File uploads
# MUST land in object storage or they vanish when the invocation ends.
BLOB_READ_WRITE_TOKEN=
# Scratch space for in-flight uploads. Must be under /tmp on Vercel.
FILE_STORAGE_PATH=/tmp/claw-uploads
ZIP_TEMP_EXTRACTION_PATH=/tmp/claw-zip-extraction


# -----------------------------------------------------------------------------
# Ollama API (external — never a local runtime)
# -----------------------------------------------------------------------------
# ClawAI on Vercel talks to an EXTERNAL Ollama-compatible API. Neither
# claw-ollama-service nor claw-llamacpp-service is deployed.
OLLAMA_BASE_URL=
# Bearer credential for the endpoint above.
# SECURITY: never mirror this into a NEXT_PUBLIC_* variable and never assign it
# to the frontend project. scripts/vercel/validate.mjs fails the run if you do.
OLLAMA_API_KEY=

OLLAMA_ROUTER_MODEL=qwen3:1.7b
OLLAMA_ROUTER_TIMEOUT_MS=5000
# Must be false on Vercel: an interval timer cannot survive between invocations.
OLLAMA_ROUTER_WARMUP_ENABLED=false
OLLAMA_GENERATE_TIMEOUT_MS=60000
# Keep the agentic loop inside the function's maxDuration.
OLLAMA_TOOL_LOOP_MAX_ITERATIONS=10
OLLAMA_TOOL_LOOP_TOTAL_TIMEOUT_MS=240000

MEMORY_EXTRACTION_MODEL=AUTO
MEMORY_SENSITIVITY_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768


# -----------------------------------------------------------------------------
# External AI providers
# -----------------------------------------------------------------------------
# Provider API keys are normally stored per-connector in the database, encrypted
# with ENCRYPTION_KEY, and entered through the ClawAI UI rather than set here.
# Populate these only if you want a provider available before any connector is
# configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=


# -----------------------------------------------------------------------------
# Research providers
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
# Externally hosted SearXNG instance. There is no local SearXNG on Vercel.
SEARXNG_BASE_URL=
RESEARCH_DOMAIN_ALLOWLIST=
RESEARCH_DOMAIN_BLOCKLIST=


# -----------------------------------------------------------------------------
# Workspace OAuth providers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

GITLAB_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FIGMA_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Values below are the Vercel-safe defaults. Read the reasoning in
# deploy/vercel/projects.json under each project's runtimeCaveats.

# No ClamAV sidecar exists on Vercel.
CLAMAV_ENABLED=false
# The tesseract worker pool needs native binaries and a persistent process.
OCR_ENABLED=false
# In-process @nestjs/schedule tickers never fire on Vercel. Leaving these on
# would be a silent no-op, so they are explicitly off. Scheduled background work
# is a documented gap — see "Disabled local-only functionality" in
# docs/deployment/vercel-automated-deployment.md.
WORKSPACE_SCHEDULER_ENABLED=false
AUTO_SUGGEST_ENABLED=false
# The nightly retention sweeper is also an in-process cron and will not fire.
FILE_RETENTION_DAYS=30

MEMORY_V2_ENABLED=true
CONTEXT_V2_ENABLED=true
RETRIEVAL_V2_ENABLED=true

ROUTING_THREAD_CONTEXT_INJECTION_ENABLED=true
ROUTING_FOLLOW_UP_DETECTION_ENABLED=true
ROUTING_FALLBACK_ATTEMPTS_ENABLED=false

ENABLE_ANTHROPIC_NATIVE_PDF=false
ENABLE_GEMINI_FILES_API=false
ALLOW_LOCAL_ONLY_ATTACHMENTS_WITHOUT_VISION=false

SEED_RECONCILE_PERMISSIONS=false
NODE_ENV=production

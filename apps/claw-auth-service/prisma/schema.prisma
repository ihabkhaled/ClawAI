generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserLanguagePreference {
  EN
  AR
  FR
  IT
  DE
  ES
  RU
  PT
  HI
  JA
  TH
  FA
  ZH
}

enum SessionClientKind {
  WEB
  VSCODE
}

enum DeviceAuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
}

enum UserAppearancePreference {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  username             String                   @unique
  passwordHash         String                   @map("password_hash")
  role                 UserRole                 @default(USER)
  // Dynamic RBAC FK (Auth/RBAC/Plans flagship). Nullable during the backfill
  // window; the resolver falls back to the `role` enum when roleId is null.
  roleId               String?                  @map("role_id")
  // Fast pointer to the user's active plan (Phase B). Nullable: ADMIN bypasses
  // plans entirely, and the column is backfilled for existing users.
  activePlanId         String?                  @map("active_plan_id")
  status               UserStatus               @default(PENDING)
  isSuperAdmin         Boolean                  @default(false) @map("is_super_admin")
  emailVerifiedAt      DateTime?                @map("email_verified_at")
  firstName            String?                  @map("first_name")
  lastName             String?                  @map("last_name")
  phone                String?                  @map("phone")
  mustChangePassword   Boolean                  @default(false) @map("must_change_password")
  languagePreference   UserLanguagePreference   @default(EN) @map("language_preference")
  appearancePreference UserAppearancePreference @default(SYSTEM) @map("appearance_preference")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  roleRef                 Role?                    @relation(fields: [roleId], references: [id])
  activePlan              Plan?                    @relation("UserActivePlan", fields: [activePlanId], references: [id])
  planAssignments         UserPlanAssignment[]
  trialRedemption         PlanTrialRedemption?
  emailChangeRequests     EmailChangeRequest[]

  @@index([email])
  @@index([status])
  @@index([roleId])
  @@index([activePlanId])
  @@map("users")
}

enum PlanAssignmentStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
}

enum PlanLifecycleStatus {
  ACTIVE
  RETIRED
}

enum PlanRetirementMigrationStatus {
  APPLIED
  BILLING_SCHEDULE_PENDING
  BILLING_SCHEDULED
  SUPERSEDED
  FAILED
}

// Admin-managed subscription plan (Phase B). Prices are modeled so billing can
// be added later; no payment integration ships now.
model Plan {
  id                                 String              @id @default(cuid())
  name                               String
  slug                               String              @unique
  description                        String?
  priceMonthly                       Decimal?            @map("price_monthly") @db.Decimal(12, 2)
  priceYearly                        Decimal?            @map("price_yearly") @db.Decimal(12, 2)
  currency                           String?             @default("USD")
  displayOrder                       Int                 @default(0) @map("display_order")
  // The plan a new signup is granted. Read by AuthManager.register and by
  // UsersService when an administrator creates an account.
  isDefault                          Boolean             @default(false) @map("is_default")
  // The plan the public pricing page badges "Most popular". A marketing
  // decision, deliberately separate from isDefault: one flag was doing both
  // jobs, so the badge always landed on whichever plan signups happened to get.
  isPopular                          Boolean             @default(false) @map("is_popular")
  // Emulated partial-unique index, following PlanPriceVersion.activeKey:
  // carries the literal 'popular' while this plan holds the badge and NULL
  // otherwise. Postgres treats every NULL as distinct, so any number of plans
  // can be un-badged but a second popular plan is rejected by the database
  // rather than by an application-level "unset the others" that races.
  popularKey                         String?             @unique @map("popular_key")
  isTrial                            Boolean             @default(false) @map("is_trial")
  trialDurationDays                  Int?                @map("trial_duration_days")
  isActive                           Boolean             @default(true) @map("is_active")
  isPublic                           Boolean             @default(true) @map("is_public")
  lifecycleStatus                    PlanLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  replacementPlanId                  String?             @map("replacement_plan_id")
  retiredAt                          DateTime?           @map("retired_at")
  dailyTokenQuota                    Int                 @default(0) @map("daily_token_quota")
  weeklyTokenQuota                   Int?                @map("weekly_token_quota")
  monthlyTokenQuota                  Int?                @map("monthly_token_quota")
  // Fair-use bound on TOTAL weighted spend in a month, across every provider
  // including local compute. Not the PAYG credit allowance — that is derived
  // from the price below. NULL means no ceiling.
  monthlyProviderCostCeilingMicroUsd BigInt?             @map("monthly_provider_cost_ceiling_micro_usd")
  // Share of what the user PAYS that becomes PAYG connector credit, in basis
  // points (3000 = 30%). The monthly grant is computed as
  // `activeMonthlyPrice.amountMinor * bps / 10000`, so it follows a price
  // change automatically and there is no absolute credit figure to drift.
  //
  // A plan with no price, or a price of zero, grants nothing: 30% of nothing is
  // nothing. That is the honest arithmetic, not an oversight — a free tier's
  // access to paid models is a separate product decision, not a side effect of
  // a percentage.
  paygCreditPercentBps               Int                 @default(3000) @map("payg_credit_percent_bps")
  // NULL = unlimited, 0 = disabled. The three are never interchangeable.
  maxConcurrentRequests              Int?                @map("max_concurrent_requests")
  maxChatsPerDay                     Int?                @map("max_chats_per_day")
  maxMessagesPerDay                  Int?                @map("max_messages_per_day")
  maxWorkspaceConnections            Int?                @map("max_workspace_connections")
  maxContextPacks                    Int?                @map("max_context_packs")
  maxMemoryItems                     Int?                @map("max_memory_items")
  allowCompareMode                   Boolean             @default(false) @map("allow_compare_mode")
  allowJudgeMode                     Boolean             @default(false) @map("allow_judge_mode")
  allowResearchMode                  Boolean             @default(false) @map("allow_research_mode")
  allowCriticReview                  Boolean             @default(false) @map("allow_critic_review")
  allowWorkspaces                    Boolean             @default(true) @map("allow_workspaces")
  allowMemory                        Boolean             @default(true) @map("allow_memory")
  allowContextPacks                  Boolean             @default(true) @map("allow_context_packs")
  // Per-lab plan-tier gates for the 9 advanced orchestration pages. Same
  // opt-in/DEFAULT(false) shape as allowCompareMode/allowJudgeMode above —
  // paired with a matching Permission (e.g. CONSENSUS_MODE_USE) so a page
  // is visible only when BOTH the user's role has the permission AND their
  // plan has the gate. Replaces the single coarse ROUTER_USE permission
  // that previously covered all 9 pages with no plan-tier distinction.
  allowConsensusMode                 Boolean             @default(false) @map("allow_consensus_mode")
  allowEscalationChain               Boolean             @default(false) @map("allow_escalation_chain")
  allowRepairLab                     Boolean             @default(false) @map("allow_repair_lab")
  allowTaskDecomposer                Boolean             @default(false) @map("allow_task_decomposer")
  allowBestOfN                       Boolean             @default(false) @map("allow_best_of_n")
  allowVerifier                      Boolean             @default(false) @map("allow_verifier")
  allowPipelineLab                   Boolean             @default(false) @map("allow_pipeline_lab")
  allowCostEnsemble                  Boolean             @default(false) @map("allow_cost_ensemble")
  allowRolePack                      Boolean             @default(false) @map("allow_role_pack")
  // New and seeded plans expose every discovered model until an administrator
  // saves an explicit allow-list or deny-all policy.
  modelAccessMode                    PlanModelAccessMode @default(ALLOW_ALL) @map("model_access_mode")
  // Routing cost classes permitted under ALLOW_COST_CLASSES. Explicit per-model
  // rows still override this set.
  allowedCostClasses                 String[]            @default([]) @map("allowed_cost_classes")
  createdAt                          DateTime            @default(now()) @map("created_at")
  updatedAt                          DateTime            @updatedAt @map("updated_at")

  modelAccess      PlanModelAccess[]
  assignments      UserPlanAssignment[]
  priceVersions    PlanPriceVersion[]
  featureRules     PlanFeatureRule[]
  activeForUsers   User[]                @relation("UserActivePlan")
  trialRedemptions PlanTrialRedemption[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("plans")
}

// Durable, idempotent provenance for a removed plan. Financial history remains
// in payment-service; paid migrations stay pending until that service schedules
// the immutable replacement price at the existing renewal boundary.
model PlanRetirementMigration {
  id                      String                        @id @default(cuid())
  sourceAssignmentId      String                        @unique @map("source_assignment_id")
  userId                  String                        @map("user_id")
  sourcePlanId            String                        @map("source_plan_id")
  replacementPlanId       String                        @map("replacement_plan_id")
  replacementAssignmentId String                        @unique @map("replacement_assignment_id")
  sourceSubscriptionId    String?                       @map("source_subscription_id")
  status                  PlanRetirementMigrationStatus
  errorCode               String?                       @map("error_code")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")

  @@index([sourcePlanId, status])
  @@index([sourceSubscriptionId])
  @@map("plan_retirement_migrations")
}

// Per-plan provider/model access. Backend source of truth for what a plan's
// users may call, and in which role (primary/fallback/judge/compare).
model PlanModelAccess {
  id                      String   @id @default(cuid())
  planId                  String   @map("plan_id")
  provider                String
  model                   String
  isAllowed               Boolean  @default(true) @map("is_allowed")
  allowAsPrimary          Boolean  @default(true) @map("allow_as_primary")
  allowAsFallback         Boolean  @default(true) @map("allow_as_fallback")
  allowAsJudge            Boolean  @default(false) @map("allow_as_judge")
  allowInCompare          Boolean  @default(true) @map("allow_in_compare")
  dailyTokenLimitOverride Int?     @map("daily_token_limit_override")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, provider, model])
  @@index([planId])
  @@map("plan_model_access")
}

// Historical record of plan assignments. The current ACTIVE row mirrors
// User.activePlanId; older rows are retained for audit.
model UserPlanAssignment {
  id                    String               @id @default(cuid())
  userId                String               @map("user_id")
  planId                String               @map("plan_id")
  status                PlanAssignmentStatus @default(ACTIVE)
  assignedByUserId      String?              @map("assigned_by_user_id")
  // Provenance. An ADMIN_GRANT must stay distinguishable from a paid
  // subscription forever — it may never fabricate or imitate a payment.
  grantType             EntitlementGrantType @default(FREE_DEFAULT) @map("grant_type")
  // Required for ADMIN_GRANT and PROMOTIONAL; enforced in the service layer.
  grantReason           String?              @map("grant_reason")
  // How long the entitlement stays valid without further confirmation. Renewal
  // extends it; grace expiry, refund and chargeback pull it back.
  entitlementValidUntil DateTime?            @map("entitlement_valid_until")
  // Opaque payment-service identifiers. Never a cross-database foreign key.
  sourceSubscriptionId  String?              @map("source_subscription_id")
  sourceEventId         String?              @map("source_event_id")
  startsAt              DateTime             @default(now()) @map("starts_at")
  endsAt                DateTime?            @map("ends_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan                 @relation(fields: [planId], references: [id])
  trialRedemption PlanTrialRedemption?

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("user_plan_assignments")
}

model PlanTrialRedemption {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  planId       String   @map("plan_id")
  assignmentId String   @unique @map("assignment_id")
  startedAt    DateTime @map("started_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id])
  assignment UserPlanAssignment @relation(fields: [assignmentId], references: [id])

  @@index([planId])
  @@map("plan_trial_redemptions")
}

// Durable per-user/day token ledger (source of truth + admin reporting). The
// runtime hot-path counter lives in Redis; this row is the reconciled total.
model TokenUsageLedger {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  planId         String?  @map("plan_id")
  date           String
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  totalTokens    Int      @default(0) @map("total_tokens")
  requestCount   Int      @default(0) @map("request_count")
  modelBreakdown Json?    @map("model_breakdown")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("token_usage_ledger")
}

// Dynamic, admin-editable role (Auth/RBAC/Plans flagship). System roles
// (ADMIN, USER) are seeded with isSystem=true and cannot be deleted/renamed.
// Admins may create custom roles (e.g. SUPPORT, READ_ONLY_ADMIN) and grant
// any subset of the fixed Permission catalog via RolePermission rows.
model Role {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  isSystem     Boolean  @default(false) @map("is_system")
  isAssignable Boolean  @default(true) @map("is_assignable")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

// One row per (role, permission) grant. `permission` stores a value from the
// fixed Permission code-catalog (shared-types). Admins toggle these rows.
model RolePermission {
  id         String   @id @default(cuid())
  roleId     String   @map("role_id")
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permissions")
}

model Session {
  id                  String            @id @default(cuid())
  userId              String            @map("user_id")
  refreshTokenHash    String            @unique @map("refresh_token_hash")
  familyId            String            @map("family_id")
  clientKind          SessionClientKind @default(WEB) @map("client_kind")
  clientName          String?           @map("client_name")
  usedAt              DateTime?         @map("used_at")
  revokedAt           DateTime?         @map("revoked_at")
  replacedBySessionId String?           @map("replaced_by_session_id")
  expiresAt           DateTime          @map("expires_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model DeviceAuthorizationGrant {
  id                 String                    @id @default(cuid())
  deviceCodeHash     String                    @unique @map("device_code_hash")
  userCode           String                    @unique @map("user_code")
  clientName         String                    @map("client_name")
  clientVersion      String                    @map("client_version")
  status             DeviceAuthorizationStatus @default(PENDING)
  approvedByUserId   String?                   @map("approved_by_user_id")
  intervalSeconds    Int                       @default(5) @map("interval_seconds")
  lastPolledAt       DateTime?                 @map("last_polled_at")
  pollViolationCount Int                       @default(0) @map("poll_violation_count")
  expiresAt          DateTime                  @map("expires_at")
  approvedAt         DateTime?                 @map("approved_at")
  deniedAt           DateTime?                 @map("denied_at")
  consumedAt         DateTime?                 @map("consumed_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([approvedByUserId])
  @@map("device_authorization_grants")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Credentials the admin deployment page uses to dispatch the production
/// deployment workflow on GitHub Actions.
///
/// Exactly one row, pinned to DEPLOYMENT_CREDENTIAL_ID. The token is stored
/// encrypted with ENCRYPTION_KEY and is never returned by any endpoint — the
/// page only ever sees `tokenLastFour`, enough to confirm which token is
/// installed without being able to reconstruct it.
///
/// When no row exists the service falls back to the GITHUB_DEPLOY_* environment
/// variables, so an existing deployment keeps working and a fresh box can still
/// be provisioned from .env alone.
model DeploymentCredential {
  id String @id

  repository           String
  ref                  String
  encryptedToken       String @map("encrypted_token")
  tokenLastFour        String @map("token_last_four")
  encryptionKeyVersion Int    @default(1) @map("encryption_key_version")

  updatedByUserId String? @map("updated_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("deployment_credentials")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Subscriptions, billing and quota (payment flagship)
//
// Auth remains the owner of identity, plan definitions, feature policy, quota
// configuration and the CURRENT entitlement projection. It never holds payment
// instruments or gateway state — the payment service owns those and drives
// entitlement changes through verified billing events consumed via the inbox
// below. A paid entitlement is therefore impossible without either a verified
// payment or an audited admin grant.
// ─────────────────────────────────────────────────────────────────────────────

enum BillingIntervalKind {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum PlanModelAccessMode {
  ALLOW_ALL
  DENY_ALL
  ALLOW_LIST
  ALLOW_COST_CLASSES
  LEGACY_UNRESTRICTED
}

enum PlanFeatureKey {
  COMPARE_MODE
  JUDGE_MODE
  RESEARCH_MODE
  WEB_SEARCH
  WEB_FETCH
  WEB_EXTRACT
  CRITIC_REVIEW
  WORKSPACES
  MEMORY
  CONTEXT_PACKS
}

enum PlanFeatureAccessMode {
  DISABLED
  ENABLED
  LIMITED
}

enum PlanFeatureWindow {
  LIFETIME
  DAY
  WEEK
  MONTH
  BILLING_PERIOD
}

enum EntitlementGrantType {
  PAID_SUBSCRIPTION
  ADMIN_GRANT
  PROMOTIONAL
  MIGRATION
  FREE_DEFAULT
}

enum FeatureUsageState {
  RESERVED
  CONSUMED
  RELEASED
}

enum WeightedUsageState {
  RESERVED
  FINALIZED
  RELEASED
}

enum EntitlementInboxStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

// Immutable price record. A price CHANGE creates a new version rather than
// mutating a column, so an existing subscription and every historical invoice
// keep charging exactly what was purchased.
model PlanPriceVersion {
  id              String              @id @default(cuid())
  planId          String              @map("plan_id")
  billingInterval BillingIntervalKind @map("billing_interval")
  currency        String              @default("USD")
  // Integer minor units ($5.00 => 500). Money is never a float anywhere.
  amountMinor     Int                 @map("amount_minor")
  version         Int
  isActive        Boolean             @default(true) @map("is_active")
  // Emulated partial-unique index: carries "<planId>:<interval>" while this
  // row is the active price and NULL once retired. Postgres treats every NULL
  // as distinct, so any number of retired rows coexist but a second ACTIVE
  // price for the same plan+interval is rejected by the database itself.
  activeKey       String?             @unique @map("active_key")
  effectiveFrom   DateTime            @default(now()) @map("effective_from")
  retiredAt       DateTime?           @map("retired_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  createdByUserId String?             @map("created_by_user_id")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingInterval, version])
  @@index([planId])
  @@index([isActive])
  @@map("plan_price_versions")
}

// Generic feature policy. Replaces the boolean-only Plan.allow* columns, which
// cannot express "one lifetime use" (Free trials) or "10 per month".
model PlanFeatureRule {
  id         String                @id @default(cuid())
  planId     String                @map("plan_id")
  feature    PlanFeatureKey
  accessMode PlanFeatureAccessMode @map("access_mode")
  // NULL for DISABLED/ENABLED; a positive integer for LIMITED.
  limit      Int?
  window     PlanFeatureWindow     @default(MONTH)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@index([planId])
  @@map("plan_feature_rules")
}

// Durable feature-run ledger. The Free tier's one-shot trials must survive a
// cleared browser, so the counter lives here and Redis is only a hot cache.
// Reserved before execution, consumed after successful delivery, released when
// execution fails before the user received a result.
model FeatureUsageRecord {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  planId     String?           @map("plan_id")
  feature    PlanFeatureKey
  window     PlanFeatureWindow
  periodKey  String            @map("period_key")
  requestId  String            @map("request_id")
  state      FeatureUsageState @default(RESERVED)
  reservedAt DateTime          @default(now()) @map("reserved_at")
  consumedAt DateTime?         @map("consumed_at")
  releasedAt DateTime?         @map("released_at")

  // Makes reservation idempotent per request — a retried request reuses its
  // reservation instead of burning a second trial.
  @@unique([userId, feature, requestId])
  @@index([userId, feature, periodKey, state])
  @@map("feature_usage_records")
}

// Per-execution weighted-token ledger. Deliberately a different grain from
// TokenUsageLedger (a per-day rollup) because reservation id, request id,
// provider, model and workflow cannot be represented in a daily aggregate.
// This is the durable source Redis counters are reconciled against.
model WeightedUsageRecord {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  planId                String?            @map("plan_id")
  subscriptionId        String?            @map("subscription_id")
  reservationId         String             @unique @map("reservation_id")
  requestId             String             @map("request_id")
  provider              String
  model                 String
  workflow              String?
  rawInputTokens        Int                @default(0) @map("raw_input_tokens")
  rawCachedTokens       Int                @default(0) @map("raw_cached_tokens")
  rawReasoningTokens    Int                @default(0) @map("raw_reasoning_tokens")
  rawOutputTokens       Int                @default(0) @map("raw_output_tokens")
  toolCallCount         Int                @default(0) @map("tool_call_count")
  // PAYG credit attribution (ADR-080: one reservation, not two). A non-PAYG
  // request leaves all three at their defaults, so every historical row stays
  // valid and old code keeps running against the new schema.
  isPayg                Boolean            @default(false) @map("is_payg")
  // What this hold took from each wallet bucket, in integer micro-USD. Kept
  // per-bucket rather than as one total because releasing a hold has to give
  // GRANT back as GRANT — returning perishable allowance as purchased credit
  // would mint permanent money out of an expiring one.
  creditGrantMicroUsd     BigInt           @default(0) @map("credit_grant_micro_usd")
  creditPurchasedMicroUsd BigInt           @default(0) @map("credit_purchased_micro_usd")
  // 1,000,000 weighted tokens == $1.00 of estimated provider cost.
  weightedTokens        Int                @default(0) @map("weighted_tokens")
  estimatedCostMicroUsd BigInt             @default(0) @map("estimated_cost_micro_usd")
  actualCostMicroUsd    BigInt?            @map("actual_cost_micro_usd")
  currency              String             @default("USD")
  state                 WeightedUsageState @default(RESERVED)
  // UTC period keys: YYYY-MM-DD, ISO week (YYYY-Www), YYYY-MM.
  dayKey                String             @map("day_key")
  weekKey               String             @map("week_key")
  monthKey              String             @map("month_key")
  billingPeriodKey      String?            @map("billing_period_key")
  createdAt             DateTime           @default(now()) @map("created_at")
  finalizedAt           DateTime?          @map("finalized_at")

  @@index([userId, dayKey])
  @@index([userId, weekKey])
  @@index([userId, monthKey])
  @@index([state, createdAt])
  @@index([requestId])
  @@map("weighted_usage_records")
}

// Inbox for billing events published by the payment service. Auth applies an
// entitlement change exactly once: the unique eventId rejects redelivery, and
// a stale event is skipped rather than allowed to overwrite newer state.
model EntitlementInboxEvent {
  id            String                 @id @default(cuid())
  eventId       String                 @unique @map("event_id")
  eventType     String                 @map("event_type")
  schemaVersion Int                    @map("schema_version")
  producer      String
  userId        String                 @map("user_id")
  payloadJson   Json                   @map("payload_json")
  status        EntitlementInboxStatus @default(PENDING)
  attempts      Int                    @default(0)
  effectiveAt   DateTime               @map("effective_at")
  processedAt   DateTime?              @map("processed_at")
  lastError     String?                @map("last_error")
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("entitlement_inbox_events")
}

enum SeedExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum EmailChangeStage {
  OLD_EMAIL_PENDING
  NEW_EMAIL_PENDING
  COMPLETED
  CANCELLED
}

// Run-once ledger for versioned data seeders. Migrations and seeds still run at
// container start, but a completed seeder is never re-executed, so restarting a
// production replica cannot re-seed over administrator-edited rows.
//
// A changed seed requires a NEW version: mutating a completed seeder and
// expecting it to re-run is exactly the failure mode this table exists to make
// impossible. The checksum records what was actually applied, so drift is
// detectable rather than silent.
model SeedExecution {
  id          String              @id @default(cuid())
  name        String
  version     Int
  checksum    String
  status      SeedExecutionStatus @default(RUNNING)
  startedAt   DateTime            @default(now()) @map("started_at")
  completedAt DateTime?           @map("completed_at")
  lastError   String?             @map("last_error")

  @@unique([name, version])
  @@index([status])
  @@map("seed_executions")
}

model EmailChangeRequest {
  id                   String           @id @default(cuid())
  userId               String           @map("user_id")
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail             String           @map("new_email")
  stage                EmailChangeStage
  oldEmailOtpHash      String           @map("old_email_otp_hash")
  oldEmailOtpExpiresAt DateTime         @map("old_email_otp_expires_at")
  oldEmailAttempts     Int              @default(0) @map("old_email_attempts")
  oldEmailVerifiedAt   DateTime?        @map("old_email_verified_at")
  newEmailTokenHash    String?          @unique @map("new_email_token_hash")
  newEmailExpiresAt    DateTime?        @map("new_email_expires_at")
  lastSentAt           DateTime?        @map("last_sent_at")
  activeKey            String?          @unique @map("active_key")
  completedAt          DateTime?        @map("completed_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([userId, stage])
  @@index([oldEmailOtpExpiresAt])
  @@index([newEmailExpiresAt])
  @@map("email_change_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pay-as-you-go connector credit (PAYG flagship)
//
// The wallet is the PROMOTED form of `Plan.monthlyProviderCostCeilingMicroUsd`:
// the same dollars the platform already enforced as a hidden margin control,
// made visible to the user and top-up-able. It is not a third allowance —
// 1 weighted token === 1 micro-USD (WEIGHTED_TOKENS_PER_USD === MICRO_USD_PER_USD),
// so the ceiling, the monthly token quota and the credit grant are one number
// wearing three names, and only one of them may bind.
//
// Every figure is integer micro-USD in a BigInt column. A float anywhere in a
// billing path is how a balance stops summing to its ledger.
//
// Postgres is authoritative for the BALANCE; Redis holds only a reconstructible
// hot counter of OUTSTANDING HOLDS. Production Redis is RDB-only, so losing its
// tail must never hand out free money. That is also why there is deliberately
// NO `version` optimistic-lock column below: Redis+Lua is the concurrency
// authority and Postgres is the durability authority, and two mechanisms
// guarding one value is exactly how the two drift apart.
// ─────────────────────────────────────────────────────────────────────────────

/// Which half of a user's wallet a movement touches. Mirrors `CreditBucket` in
/// @claw/shared-types member for member — the wire payload and the column must
/// never disagree about what "GRANT" means.
///
/// GRANT resets each period and does NOT roll over. PURCHASED was paid for with
/// real money and never expires. Debits take GRANT first (spend the perishable
/// half before the money someone paid for); refunds return to PURCHASED first
/// (handing cash back as a bucket that expires at month end would quietly
/// confiscate it).
enum CreditBucket {
  GRANT
  PURCHASED
}

/// Why a row exists in the append-only credit ledger. Mirrors
/// `CreditLedgerKind` in @claw/shared-types member for member.
///
/// A correction is ALWAYS a new compensating row and never an edit — the same
/// rule the payment service's financial tables follow.
enum CreditLedgerKind {
  /// Monthly plan allowance credited at a billing-period boundary.
  PLAN_GRANT
  /// Unused GRANT swept at the period roll, so the ledger still sums to the wallet.
  GRANT_EXPIRY
  /// Credit bought with real money. Carries the payment event id for idempotency.
  TOPUP
  /// A refunded or charged-back top-up, reversed against the PURCHASED bucket.
  TOPUP_REVERSAL
  /// A pre-flight hold. Negative; released or converted to CONSUMPTION.
  RESERVATION
  /// A hold given back because the request never reached the provider.
  RESERVATION_RELEASE
  /// Settled spend. The difference against its RESERVATION is the reconciliation.
  CONSUMPTION
  /// Operator correction. Requires a reason and an actor; never imitates a payment.
  ADMIN_ADJUSTMENT
  /// Credit returned because the provider failed after money was already held.
  PROVIDER_FAILURE_REFUND
}

/// One user's credit balance. A materialized sum of `CreditLedgerEntry`, kept as
/// a row so the reservation gate is one indexed read rather than an aggregate
/// over a table that grows with every request.
///
/// The three balances are deliberately GROSS of holds:
///   available = grant + purchased − reserved   (floored at 0)
/// which is the number the gate compares against and the number the UI shows.
/// Storing a pre-netted balance instead would make an abandoned hold
/// indistinguishable from spend.
model UserCreditWallet {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// Perishable plan allowance remaining this period, NET of settled spend and
  /// GROSS of outstanding holds.
  grantMicroUsd     BigInt @default(0) @map("grant_micro_usd")
  /// Credit bought with real money. Never expires, survives a downgrade.
  purchasedMicroUsd BigInt @default(0) @map("purchased_micro_usd")
  /// Total currently held by in-flight requests, across BOTH buckets. Mirrored
  /// by the two Redis hold counters; reclaimed by the reservation sweeper when a
  /// request dies without finalizing.
  reservedMicroUsd  BigInt @default(0) @map("reserved_micro_usd")

  /// What this period's grant STARTED at — the denominator of the usage bar and
  /// of the low-balance thresholds. Not derivable from `grantMicroUsd`, which
  /// has already been spent down.
  periodGrantMicroUsd BigInt   @default(0) @map("period_grant_micro_usd")
  /// UTC `YYYY-MM`. Renewal is driven off a MISMATCH with the current key, so a
  /// missed run self-heals on the next tick instead of skipping a period.
  periodKey           String   @map("period_key")
  grantResetsAt       DateTime @map("grant_resets_at")

  /// Lifetime counters, for support and finance. Monotonic: never decremented,
  /// so they stay meaningful after a reversal writes its own compensating row.
  lifetimeGrantedMicroUsd   BigInt @default(0) @map("lifetime_granted_micro_usd")
  lifetimePurchasedMicroUsd BigInt @default(0) @map("lifetime_purchased_micro_usd")
  lifetimeConsumedMicroUsd  BigInt @default(0) @map("lifetime_consumed_micro_usd")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries CreditLedgerEntry[]

  @@index([periodKey])
  @@map("user_credit_wallets")
}

/// Append-only. The source of truth a wallet must always reconcile to:
///   wallet.grantMicroUsd     == SUM(grant_delta_micro_usd)
///   wallet.purchasedMicroUsd == SUM(purchased_delta_micro_usd)
///   available                == SUM(amount_micro_usd)
///
/// The third identity is what makes an open hold auditable: a RESERVATION row
/// carries a NEGATIVE `amountMicroUsd` and ZERO bucket deltas, and its matching
/// RESERVATION_RELEASE carries the exact positive mirror — so the pair cancels
/// once settled, while an outstanding hold leaves precisely `-reserved` behind.
/// CONSUMPTION is the only kind that moves the buckets for a request.
///
/// Nothing here is ever UPDATEd. A correction is a new compensating row.
model CreditLedgerEntry {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  walletId String @map("wallet_id")

  kind CreditLedgerKind

  /// Signed. Positive credits the wallet, negative debits it.
  amountMicroUsd         BigInt @map("amount_micro_usd")
  grantDeltaMicroUsd     BigInt @default(0) @map("grant_delta_micro_usd")
  purchasedDeltaMicroUsd BigInt @default(0) @map("purchased_delta_micro_usd")
  /// Running `available` after this row, so a user can audit the arithmetic
  /// themselves instead of trusting a computed total.
  balanceAfterMicroUsd   BigInt @map("balance_after_micro_usd")

  reservationId String? @map("reservation_id")
  requestId     String? @map("request_id")
  provider      String?
  model         String?
  /// `PaygSurface`. Stored as text, not a native enum: a new surface must not
  /// need a migration to become spendable, and "where did my $5 go" has to stay
  /// answerable for surfaces added after this row was written.
  surface       String?
  workflow      String?

  /// Idempotency key for money arriving from outside auth-service. A redelivered
  /// `billing.credit.topup_succeeded` collides here and is rejected BY THE
  /// DATABASE rather than by an application check two consumers can race.
  sourceEventId String? @unique @map("source_event_id")

  /// Set only for operator-initiated rows. An ADMIN_ADJUSTMENT without both of
  /// these is refused by the service — an unattributed credit is
  /// indistinguishable from a fabricated payment.
  actorUserId String? @map("actor_user_id")
  reason      String?

  occurredAt DateTime @default(now()) @map("occurred_at")

  wallet UserCreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([reservationId])
  @@map("credit_ledger_entries")
}

/// A purchasable top-up SKU. The row itself carries no money — every price lives
/// in an immutable `CreditPackageVersion`, so retiring or repricing a package
/// cannot rewrite what an existing checkout session quoted.
model CreditPackage {
  id           String   @id @default(cuid())
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  versions CreditPackageVersion[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("credit_packages")
}

/// IMMUTABLE. A price or ratio CHANGE creates a new version rather than mutating
/// a column, exactly as `PlanPriceVersion` does, so a completed purchase and
/// every historical invoice keep meaning what was actually bought.
///
/// `priceMinor` and `creditMicroUsd` are independent on purpose: the ratio
/// between them IS the platform's margin on a top-up. Pinning it to 1:1 in code
/// would book negative gross margin the moment a gateway fee is paid, so it
/// lives in the database where an operator can change it without a deploy.
model CreditPackageVersion {
  id        String @id @default(cuid())
  packageId String @map("package_id")

  /// Integer minor units ($5.00 => 500). Money is never a float anywhere.
  priceMinor     Int    @map("price_minor")
  currency       String @default("USD")
  /// What the buyer receives, in integer micro-USD.
  creditMicroUsd BigInt @map("credit_micro_usd")

  version  Int
  isActive Boolean @default(true) @map("is_active")
  /// Emulated partial-unique index, copied from `PlanPriceVersion.activeKey`:
  /// carries the package id while this row is the active price and NULL once
  /// retired. Postgres treats every NULL as distinct, so any number of retired
  /// rows coexist while a second ACTIVE price for one package is rejected by the
  /// database itself rather than by an "unset the others" that two admins race.
  activeKey String? @unique @map("active_key")

  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  retiredAt       DateTime? @map("retired_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  package CreditPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, version])
  @@index([packageId])
  @@index([isActive])
  @@map("credit_package_versions")
}

{
  "name": "claw-workspace-service",
  "version": "0.1.0",
  "private": true,
  "description": "Claw Workspace Service - manages workspace tool connectors (Slack, Jira, GitHub, Figma, etc.)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && concurrently -k -n tsgo,alias,node -c blue,magenta,green \"tsgo -p tsconfig.build.json --watch\" \"tsc-alias -p tsconfig.build.json --watch\" \"nodemon --watch dist --delay 1500ms --signal SIGTERM dist/main.js\"",
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/ --concurrency=4",
    "lint:strict": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsgo --noEmit",
    "validate": "npm run typecheck && npm run lint:strict && npm run format:check",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@claw/shared-auth": "*",
    "@claw/shared-constants": "*",
    "@claw/shared-entitlements": "*",
    "@claw/shared-rabbitmq": "*",
    "@claw/shared-types": "*",
    "@claw/shared-utilities": "*",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^2.0.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.0",
    "isomorphic-dompurify": "^2.16.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.27",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "^7.0.0-dev.20260601.1",
    "concurrently": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}

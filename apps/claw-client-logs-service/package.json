{
  "name": "claw-client-logs-service",
  "version": "0.1.0",
  "private": true,
  "description": "Claw Client Logs Service - Frontend client log ingestion and querying",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && concurrently -k -n tsgo,alias,node -c blue,magenta,green \"tsgo -p tsconfig.build.json --watch\" \"tsc-alias -p tsconfig.build.json --watch\" \"nodemon --watch dist --delay 1500ms --signal SIGTERM dist/main.js\"",
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/ --concurrency=4",
    "lint:strict": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsgo --noEmit",
    "validate": "npm run typecheck && npm run lint:strict && npm run format:check",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@claw/shared-constants": "*",
    "@claw/shared-rabbitmq": "*",
    "@claw/shared-types": "*",
    "@claw/shared-utilities": "*",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.5.0",
    "amqplib": "^2.0.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.2",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.24",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "npm:@typescript/native-preview@beta",
    "typescript-eslint": "^8.59.3"
  }
}

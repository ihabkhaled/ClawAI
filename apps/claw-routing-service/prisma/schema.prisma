  ACTIVE
  PREVIEW
  DEPRECATED
  DISABLED
  REMOVED
}

enum CostConfidence {
  EXACT
  ESTIMATED
  UNKNOWN
}

enum CostClass {
  FREE
  CHEAP
  STANDARD
  PREMIUM
  ULTRA
}

enum LatencyClass {
  REALTIME
  FAST
  MEDIUM
  SLOW
  HEAVY
}

enum QualityTier {
  S
  A
  B
  C
  D
}

enum PrivacyClass {
  PUBLIC_OK
  CLOUD_PERMITTED
  LOCAL_PREFERRED
  LOCAL_ONLY
}

enum ModalityKind {
  TEXT
  CODE
  IMAGE_INPUT
  IMAGE_OUTPUT
  AUDIO_INPUT
  AUDIO_OUTPUT
  VIDEO_INPUT
  VIDEO_OUTPUT
  FILE_INPUT
  PDF_INPUT
  SPREADSHEET_INPUT
  WEB_INPUT
  YOUTUBE_INPUT
  STRUCTURED_OUTPUT
  TOOL_CALLING
  STREAMING
  EMBEDDING
}

enum WorkflowKind {
  DIRECT_LLM
  SEARCH_FIRST
  EXTRACT_FIRST
  PDF_EXTRACTION
  YOUTUBE_TRANSCRIPT
  IMAGE_ANALYSIS
  IMAGE_GENERATION
  VIDEO_ANALYSIS
  AUDIO_TRANSCRIBE
  FILE_GENERATION
  CODE_REVIEW
  COMPARE_ENSEMBLE
  JUDGE_PIPELINE
}

enum DomainTag {
  GENERAL
  CODING
  MEDICAL
  LEGAL
  FINANCE
  MARKETING
  EDUCATION
  CREATIVE_WRITING
  RESEARCH
  MECHANICAL
  AUTOMOTIVE
  BIOLOGY
  CHEMISTRY
  PHYSICS
  MULTIMEDIA
  BUSINESS
  HR
  SALES
  TRANSLATION
  MENTAL_HEALTH
  LITERATURE
}

// ─── Cloud Smart Router — model definition vs deployment ─────────────────
//
// RouterModelRegistry answers "what model is this". ModelDeployment answers
// "how do we reach it". The distinction matters because one definition can be
// reachable through several endpoints with different credentials, region,
// privacy class, price and health — and because `provider` on the legacy
// tables is a free-form String whose allowed values live only in a comment.
// These enums are additive: no existing String column is migrated here.

/// Canonical provider identity. OLLAMA and OLLAMA_CLOUD are deliberately
/// distinct: connector-service already rewrites any localhost Ollama base URL
/// to https://ollama.com/api, so one identifier was covering both a local
/// runtime and a third-party cloud endpoint with completely different privacy
/// and billing semantics.
enum RouterProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
  GROK
  AWS_BEDROCK
  OLLAMA
  OLLAMA_CLOUD
  LLAMACPP
}

enum DeploymentType {
  CLOUD_API
  CLOUD_SUBSCRIPTION
  PRIVATE_CLOUD
  LOCAL
  AIR_GAPPED
}

/// A deployment is never eligible on the word of a seed alone. Seeded rows land
/// in REQUIRES_VALIDATION and only discovery + a health check can promote them.
enum DeploymentActivationState {
  REQUIRES_VALIDATION
  ACTIVE
  UNHEALTHY
  QUARANTINED
  DISABLED
  RETIRED
}

/// Ollama Cloud bills by subscription/usage-limit rather than per token, so a
/// fabricated per-token price would be worse than admitting the unknown.
enum BillingModel {
  TOKEN
  REQUEST
  SUBSCRIPTION
  USAGE_LIMIT
  UNKNOWN
}

/// Deployment policy for a router configuration. CLOUD_FIRST is the new SaaS
/// default; the local and private modes stay first-class so an air-gapped
/// install is a configuration choice rather than a fork.
enum RouterConfigurationMode {
  CLOUD_FIRST
  HYBRID
  PRIVATE_CLOUD
  LOCAL_ONLY
}

/// A revision is immutable once PUBLISHED. Editing produces a new revision, so
/// "what was the router doing at 14:03" always has an answer, and rollback is
/// publishing an older revision's content as a newer one rather than mutating
/// history.
enum RouterConfigurationStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// What a chain entry is for. Role is documentation for operators and a
/// validation aid — the coordinator branches on canonical error scope, never on
/// this — but a chain whose roles contradict its order is a misconfiguration
/// worth refusing.
enum RouterChainEntryRole {
  PRIMARY
  MODEL_FALLBACK
  PROVIDER_FALLBACK
  PROVIDER_MODEL_FALLBACK
  LAST_RESORT
  QUALITY_ESCALATION
}

/// What happens when a decision is valid but under the confidence floor.
/// Distinct from provider failure throughout: the call succeeded.
enum LowConfidenceAction {
  QUALITY_ESCALATION_THEN_DETERMINISTIC
  DETERMINISTIC_ONLY
  FAIL_CLOSED
}

/// Where a capability claim came from. A provider marketing page and a measured
/// lab probe must never be indistinguishable once stored.
enum EvidenceSource {
  PROVIDER_DECLARED
  MANUAL_VERIFIED
  LAB_MEASURED
  PRODUCTION_OBSERVED
  LEARNED_AGGREGATE
}

// ─── Models ──────────────────────────────────────────────

model RoutingDecision {
  id                      String                  @id @default(cuid())
  messageId               String?                 @map("message_id")
  threadId                String                  @map("thread_id")
  messageContent          String?                 @map("message_content")
  selectedProvider        String                  @map("selected_provider")
  selectedModel           String                  @map("selected_model")
  routingMode             RoutingMode             @map("routing_mode")
  confidence              Decimal?                @db.Decimal(5, 4)
  reasonTags              String[]                @map("reason_tags")
  privacyClass            String?                 @map("privacy_class")
  costClass               String?                 @map("cost_class")
  fallbackProvider        String?                 @map("fallback_provider")
  fallbackModel           String?                 @map("fallback_model")
  complexityClass         ComplexityClass?        @map("complexity_class")
  detectedCategory        String?                 @map("detected_category")
  secondaryCategory       String?                 @map("secondary_category")
  matchCount              Int?                    @map("match_count")
  selectedExecutionPath   String?                 @map("selected_execution_path")
  routeRoadmap            Json?                   @map("route_roadmap")
  modelInventorySnapshot  Json?                   @map("model_inventory_snapshot")
  connectorHealthSnapshot Json?                   @map("connector_health_snapshot")
  capabilityMatchScore    Decimal?                @map("capability_match_score") @db.Decimal(5, 4)
  latencyScore            Decimal?                @map("latency_score") @db.Decimal(5, 4)
  riskScore               Decimal?                @map("risk_score") @db.Decimal(5, 4)
  uncertaintyScore        Decimal?                @map("uncertainty_score") @db.Decimal(5, 4)
  explanation             Json?
  routingDurationMs       Int?                    @map("routing_duration_ms")
  // Semantic Router Flagship Phase 2 — shadow-mode analyzer output.
  // Populated async by SemanticIntentAnalyzerManager when
  // ROUTING_SEMANTIC_ANALYZER_ENABLED=true. Phase 4 promotes this to
  // an input for the AI Route Planner; until then it's observe-only.
  semanticAnalysis        Json?                   @map("semantic_analysis")
  // Semantic Router Flagship Phase 4 — shadow-mode planner output. Chained
  // after semanticAnalysis (uses it as input). Stored AIRoutePlanRecord
  // including status, plan, validationIssues, attempts, durationMs.
  aiRoutePlan             Json?                   @map("ai_route_plan")
  // Semantic Router Flagship Phase 6 — live workflow wiring. Optional so
  // the v1 hot path keeps writing rows when the wiring is disabled.
  // Today only DIRECT_LLM + SEARCH_FIRST are LIVE; the rest are surfaced
  // through `selectedWorkflow=NULL` plus the workflowReason string.
  selectedWorkflow        WorkflowKind?           @map("selected_workflow")
  workflowReason          String?                 @map("workflow_reason")
  createdAt               DateTime                @default(now()) @map("created_at")
  outcomes                RoutingOutcomeRecord[]
  feedbackRecords         RoutingFeedbackRecord[]

  @@index([messageId])
  @@index([threadId])
  @@index([routingMode])
  @@index([selectedProvider, selectedModel])
  @@index([detectedCategory])
  @@index([createdAt])
  @@index([selectedWorkflow])
  @@map("routing_decisions")
}

model RoutingPolicy {
  id          String      @id @default(cuid())
  name        String
  routingMode RoutingMode @map("routing_mode")
  priority    Int         @default(0)
  isActive    Boolean     @default(true) @map("is_active")
  config      Json
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([routingMode])
  @@index([isActive])
  @@index([priority])
  @@map("routing_policies")
}

model ReplayRun {
  id              String       @id @default(cuid())
  name            String?
  filters         Json
  totalReplayed   Int          @map("total_replayed")
  changedCount    Int          @map("changed_count")
  suspiciousCount Int          @map("suspicious_count")
  avgConfOld      Decimal      @map("avg_conf_old") @db.Decimal(5, 4)
  avgConfNew      Decimal      @map("avg_conf_new") @db.Decimal(5, 4)
  avgImprovement  Decimal      @map("avg_improvement") @db.Decimal(6, 4)
  labelBreakdown  Json         @map("label_breakdown")
  createdAt       DateTime     @default(now()) @map("created_at")
  cases           ReplayCase[]

  @@index([createdAt])
  @@map("replay_runs")
}

model ReplayCase {
  id                    String       @id @default(cuid())
  runId                 String       @map("run_id")
  decisionId            String?      @map("decision_id")
  messagePreview        String       @map("message_preview")
  messageContent        String?      @map("message_content")
  hasOriginalContent    Boolean      @map("has_original_content")
  oldProvider           String       @map("old_provider")
  oldModel              String       @map("old_model")
  oldConfidence         Decimal?     @map("old_confidence") @db.Decimal(5, 4)
  oldCostClass          String?      @map("old_cost_class")
  newProvider           String       @map("new_provider")
  newModel              String       @map("new_model")
  newConfidence         Decimal      @map("new_confidence") @db.Decimal(5, 4)
  newCostClass          String       @map("new_cost_class")
  changed               Boolean
  improvementScore      Decimal      @map("improvement_score") @db.Decimal(6, 4)
  outcomeLabel          OutcomeLabel @map("outcome_label")
  isSuspicious          Boolean      @map("is_suspicious")
  suspiciousReasons     String[]     @map("suspicious_reasons")
  isConfirmedRegression Boolean      @default(false) @map("is_confirmed_regression")
  reviewNotes           String?      @map("review_notes")
  isPromoted            Boolean      @default(false) @map("is_promoted")
  reviewedAt            DateTime?    @map("reviewed_at")
  run                   ReplayRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now()) @map("created_at")

  @@index([runId])
  @@index([isSuspicious])
  @@index([outcomeLabel])
  @@index([isConfirmedRegression])
  @@map("replay_cases")
}

model RoutingOutcomeRecord {
  id                     String                 @id @default(cuid())
  routingDecisionId      String                 @map("routing_decision_id")
  messageId              String?                @map("message_id")
  assistantMessageId     String?                @map("assistant_message_id")
  threadId               String                 @map("thread_id")
  finalExecutionProvider String                 @map("final_execution_provider")
  finalExecutionModel    String                 @map("final_execution_model")
  executionStatus        RoutingExecutionStatus @map("execution_status")
  executionSuccess       Boolean                @default(true) @map("execution_success")
  actualLatencyMs        Int?                   @map("actual_latency_ms")
  actualCostEstimate     Decimal?               @map("actual_cost_estimate") @db.Decimal(12, 8)
  finalStatus            String                 @default("completed") @map("final_status")
  fallbackUsed           Boolean                @default(false) @map("fallback_used")
  judgeOutcome           JudgeOutcome           @default(NONE) @map("judge_outcome")
  judgeConfidence        Decimal?               @map("judge_confidence") @db.Decimal(5, 4)
  criticScore            Decimal?               @map("critic_score") @db.Decimal(5, 4)
  issueTags              String[]               @default([]) @map("issue_tags")
  revised                Boolean                @default(false)
  escalated              Boolean                @default(false)
  followUpSignal         String?                @map("follow_up_signal")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  routingDecision        RoutingDecision        @relation(fields: [routingDecisionId], references: [id], onDelete: Cascade)

  @@unique([routingDecisionId])
  @@index([threadId])
  @@index([executionStatus])
  @@index([judgeOutcome])
  @@map("routing_outcome_records")
}

model RoutingFeedbackRecord {
  id                 String           @id @default(cuid())
  routingDecisionId  String?          @map("routing_decision_id")
  messageId          String           @map("message_id")
  threadId           String           @map("thread_id")
  assistantMessageId String?          @map("assistant_message_id")
  feedbackValue      FeedbackValue    @map("feedback_value")
  source             String           @default("thumbs")
  weight             Decimal          @default(1.0) @db.Decimal(6, 4)
  taskFamily         String?          @map("task_family")
  createdAt          DateTime         @default(now()) @map("created_at")
  routingDecision    RoutingDecision? @relation(fields: [routingDecisionId], references: [id], onDelete: SetNull)

  @@index([routingDecisionId])
  @@index([threadId])
  @@index([feedbackValue])
  @@map("routing_feedback_records")
}

model RouterModelProfile {
  id                           String   @id @default(cuid())
  provider                     String
  model                        String
  taskFamily                   String   @map("task_family")
  topicKey                     String   @map("topic_key")
  routeCount                   Int      @default(0) @map("route_count")
  successRate                  Decimal  @default(0) @map("success_rate") @db.Decimal(6, 4)
  thumbsUpRate                 Decimal  @default(0) @map("thumbs_up_rate") @db.Decimal(6, 4)
  thumbsDownRate               Decimal  @default(0) @map("thumbs_down_rate") @db.Decimal(6, 4)
  judgeVerifiedRate            Decimal  @default(0) @map("judge_verified_rate") @db.Decimal(6, 4)
  judgeRevisedRate             Decimal  @default(0) @map("judge_revised_rate") @db.Decimal(6, 4)
  judgeEscalatedRate           Decimal  @default(0) @map("judge_escalated_rate") @db.Decimal(6, 4)
  averageLatencyMs             Int      @default(0) @map("average_latency_ms")
  averageCostEstimate          Decimal  @default(0) @map("average_cost_estimate") @db.Decimal(12, 8)
  fallbackSuccessRate          Decimal  @default(0) @map("fallback_success_rate") @db.Decimal(6, 4)
  hallucinationRiskScore       Decimal  @default(0) @map("hallucination_risk_score") @db.Decimal(6, 4)
  calibrationTrustScore        Decimal  @default(0) @map("calibration_trust_score") @db.Decimal(6, 4)
  weightedSuccessScore         Decimal  @default(0) @map("weighted_success_score") @db.Decimal(6, 4)
  weightedDissatisfactionScore Decimal  @default(0) @map("weighted_dissatisfaction_score") @db.Decimal(6, 4)
  sampleSize                   Int      @default(0) @map("sample_size")
  confidenceInProfile          Decimal  @default(0) @map("confidence_in_profile") @db.Decimal(6, 4)
  lastUpdated                  DateTime @default(now()) @map("last_updated")

  @@unique([provider, model, taskFamily, topicKey])
  @@index([taskFamily, topicKey])
  @@index([weightedSuccessScore])
  @@map("router_model_profiles")
}

model RouterTopicProfile {
  id                   String   @id @default(cuid())
  taskFamily           String   @map("task_family")
  topicKey             String   @map("topic_key")
  bestProvider         String?  @map("best_provider")
  bestModel            String?  @map("best_model")
  routeCount           Int      @default(0) @map("route_count")
  successRate          Decimal  @default(0) @map("success_rate") @db.Decimal(6, 4)
  thumbsUpRate         Decimal  @default(0) @map("thumbs_up_rate") @db.Decimal(6, 4)
  thumbsDownRate       Decimal  @default(0) @map("thumbs_down_rate") @db.Decimal(6, 4)
  judgeVerifiedRate    Decimal  @default(0) @map("judge_verified_rate") @db.Decimal(6, 4)
  judgeEscalatedRate   Decimal  @default(0) @map("judge_escalated_rate") @db.Decimal(6, 4)
  fallbackSuccessRate  Decimal  @default(0) @map("fallback_success_rate") @db.Decimal(6, 4)
  weightedSuccessScore Decimal  @default(0) @map("weighted_success_score") @db.Decimal(6, 4)
  ambiguityScore       Decimal  @default(0) @map("ambiguity_score") @db.Decimal(6, 4)
  confidenceInProfile  Decimal  @default(0) @map("confidence_in_profile") @db.Decimal(6, 4)
  lastUpdated          DateTime @default(now()) @map("last_updated")

  @@unique([taskFamily, topicKey])
  @@index([weightedSuccessScore])
  @@map("router_topic_profiles")
}

model RoutingCalibrationSnapshot {
  id          String   @id @default(cuid())
  version     String
  windowDays  Int      @map("window_days")
  summary     Json
  promptHints Json     @map("prompt_hints")
  active      Boolean  @default(true)
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([generatedAt])
  @@index([active])
  @@map("routing_calibration_snapshots")
}

// ─── Smart Router Flagship — Model Intelligence Registry ───

/// Canonical registry of every model the router knows.
/// Distinct from the existing `RouterModelProfile` table which tracks per-task
/// learned metrics (per (provider,model,taskFamily,topicKey)). The registry
/// records identity, capabilities, economics, and lifecycle — one row per model.
model RouterModelRegistry {
  id                       String         @id @default(cuid())
  // identity
  provider                 String // "OPENAI" | "ANTHROPIC" | "GEMINI" | "GROK" | "BEDROCK" | "DEEPSEEK" | "OLLAMA" | "LLAMACPP" | ...
  modelKey                 String         @map("model_key") // wire-name e.g. "gpt-4o-2024-11-20"
  displayName              String         @map("display_name")
  family                   String?
  connectorId              String?        @map("connector_id") // for cloud models — id from connector-service
  runtimeId                String?        @map("runtime_id") // for local models — id from ollama/llamacpp service
  // classification flags
  isLocal                  Boolean        @default(false) @map("is_local")
  isRouterOnly             Boolean        @default(false) @map("is_router_only")
  isExecutionCapable       Boolean        @default(true) @map("is_execution_capable")
  lifecycle                ModelLifecycle @default(ACTIVE)
  // capabilities
  modalitiesIn             ModalityKind[] @default([]) @map("modalities_in")
  modalitiesOut            ModalityKind[] @default([]) @map("modalities_out")
  contextWindowTokens      Int?           @map("context_window_tokens")
  maxOutputTokens          Int?           @map("max_output_tokens")
  domainTags               DomainTag[]    @default([]) @map("domain_tags")
  notRecommendedFor        DomainTag[]    @default([]) @map("not_recommended_for")
  // economics
  inputCostPer1M           Decimal?       @map("input_cost_per_1m") @db.Decimal(12, 6)
  outputCostPer1M          Decimal?       @map("output_cost_per_1m") @db.Decimal(12, 6)
  costConfidence           CostConfidence @default(UNKNOWN) @map("cost_confidence")
  costClass                CostClass?     @map("cost_class")
  // performance (rolled from telemetry)
  latencyP50Ms             Int?           @map("latency_p50_ms")
  latencyP95Ms             Int?           @map("latency_p95_ms")
  latencyClass             LatencyClass?  @map("latency_class")
  // quality / safety
  qualityTier              QualityTier    @default(B) @map("quality_tier")
  hallucinationRisk        Decimal?       @map("hallucination_risk") @db.Decimal(4, 3)
  judgeSuitability         Boolean        @default(false) @map("judge_suitability")
  searchSuitability        Boolean        @default(false) @map("search_suitability")
  fallbackSuitability      Boolean        @default(true) @map("fallback_suitability")
  // privacy
  privacySupport           PrivacyClass   @default(CLOUD_PERMITTED) @map("privacy_support")
  // metadata
  metadataSource           String         @default("seed") @map("metadata_source") // seed | connector_sync | ollama_sync | llamacpp_sync | admin_override | learned
  externalCardUrl          String?        @map("external_card_url")
  notes                    String?
  // ─── Semantic Router Flagship — Phase 3: Model Intelligence enrichment ───
  // All fields below are additive and nullable / default-falsy. They surface
  // richer capability / cost / latency / domain metadata for the AI Route
  // Planner (Phase 4), Fallback Executor (Phase 5), and Learning Loop
  // (Phase 9). They MUST stay backwards compatible — the v1 hot path does
  // not read any of them.
  //
  // Capability flags. Unknown capability = NULL (NOT false). The planner
  // treats null as "do not assume; do not select for high-risk".
  supportsStreaming        Boolean?       @default(false) @map("supports_streaming")
  supportsTools            Boolean?       @default(false) @map("supports_tools")
  supportsStructuredOutput Boolean?       @default(false) @map("supports_structured_output")
  supportsVision           Boolean?       @default(false) @map("supports_vision")
  supportsAudioInput       Boolean?       @default(false) @map("supports_audio_input")
  supportsAudioOutput      Boolean?       @default(false) @map("supports_audio_output")
  supportsVideoInput       Boolean?       @default(false) @map("supports_video_input")
  supportsFileInput        Boolean?       @default(false) @map("supports_file_input")
  supportsEmbeddings       Boolean?       @default(false) @map("supports_embeddings")
  supportsLongContext      Boolean?       @default(false) @map("supports_long_context")
  // Token ceilings as exposed by upstream cards (already covered by
  // contextWindowTokens/maxOutputTokens above — these aliases let the
  // intelligence shape stay 1:1 with §6.1 of the flagship prompt).
  maxContextTokens         Int?           @map("max_context_tokens")
  maxOutputTokensIntel     Int?           @map("max_output_tokens_intel")
  // Domain / role guidance for the planner. String arrays so future
  // taxonomy additions don't require a new migration.
  domainStrengths          String[]       @default([]) @map("domain_strengths")
  roleStrengths            String[]       @default([]) @map("role_strengths")
  weakDomains              String[]       @default([]) @map("weak_domains")
  bestFor                  String[]       @default([]) @map("best_for")
  avoidFor                 String[]       @default([]) @map("avoid_for")
  languageStrengths        String[]       @default([]) @map("language_strengths")
  // Quality / cost / latency / privacy as STRING tier labels separate from
  // the existing typed enum columns. This keeps the canonical enum columns
  // untouched while giving the planner a free-form override hook.
  qualityTierLabel         String?        @map("quality_tier_label") // "BASIC" | "STANDARD" | "PRO" | "FRONTIER"
  costClassLabel           String?        @map("cost_class_label") // "FREE" | "LOW" | "MEDIUM" | "HIGH" | "PREMIUM"
  costConfidenceLabel      String?        @map("cost_confidence_label") // "EXACT" | "ESTIMATED" | "UNKNOWN"
  estimatedInputCostPer1M  Float?         @map("estimated_input_cost_per_1m")
  estimatedOutputCostPer1M Float?         @map("estimated_output_cost_per_1m")
  latencyClassLabel        String?        @map("latency_class_label") // "FAST" | "MEDIUM" | "SLOW"
  privacyClassLabel        String?        @map("privacy_class_label") // "local" | "cloud"
  // adminOverrideJson is the "freeze" block. Sync passes MUST NOT overwrite
  // any key present here. See `ModelIntelligenceService.applyOverrides()`
  // and `RouterSyncManager.applySnapshot()`.
  adminOverrideJson        Json?          @map("admin_override_json")
  lastEnrichedAt           DateTime?      @map("last_enriched_at")
  // bookkeeping
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  lastSyncedAt             DateTime?      @map("last_synced_at")

  overrides   RouterAdminOverride[]
  deployments ModelDeployment[]
  evidence    CapabilityEvidence[]

  @@unique([provider, modelKey])
  @@index([provider])
  @@index([lifecycle])
  @@index([isExecutionCapable, lifecycle])
  @@index([isRouterOnly])
  @@map("router_model_registry")
}

/// One reachable endpoint for one model definition.
///
/// A definition can have many deployments — the same underlying model behind a
/// direct API key, behind a private-cloud gateway, and behind a local runtime —
/// each with its own credentials, region, privacy class, limits, price and
/// health. Nothing here stores a secret: `connectorId` references a
/// connector-service record and the key never leaves that service.
model ModelDeployment {
  id String @id @default(cuid())

  definitionId String              @map("definition_id")
  definition   RouterModelRegistry @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  // ── identity ──
  /// Stable composite identity, e.g. "GEMINI:gemini-2.5-flash:conn_abc123".
  /// An explicit column rather than a multi-column unique because connectorId
  /// and runtimeId are nullable, and Postgres treats NULLs as distinct — a
  /// composite unique would silently permit duplicate local deployments.
  deploymentKey   String         @unique @map("deployment_key")
  provider        RouterProvider
  /// The id the provider itself expects on the wire, which is not always the
  /// definition's modelKey (aliases, dated snapshots, ":cloud" suffixes).
  providerModelId String         @map("provider_model_id")
  connectorId     String?        @map("connector_id")
  runtimeId       String?        @map("runtime_id")

  // ── placement ──
  deploymentType   DeploymentType            @map("deployment_type")
  region           String?
  privacyClass     PrivacyClass              @default(CLOUD_PERMITTED) @map("privacy_class")
  activationState  DeploymentActivationState @default(REQUIRES_VALIDATION) @map("activation_state")
  quarantineReason String?                   @map("quarantine_reason")

  // ── per-endpoint capability overrides; NULL means "inherit the definition" ──
  contextWindowTokens      Int?     @map("context_window_tokens")
  maxOutputTokens          Int?     @map("max_output_tokens")
  supportsTools            Boolean? @map("supports_tools")
  supportsStructuredOutput Boolean? @map("supports_structured_output")
  supportsStreaming        Boolean? @map("supports_streaming")
  supportsVision           Boolean? @map("supports_vision")

  // ── limits and economics ──
  rateLimitRpm   Int?         @map("rate_limit_rpm")
  rateLimitTpm   Int?         @map("rate_limit_tpm")
  billingModel   BillingModel @default(UNKNOWN) @map("billing_model")
  /// Points at ModelCostVersion.activeKey rather than duplicating rates, so
  /// pricing stays immutable and versioned in one place.
  costVersionKey String?      @map("cost_version_key")

  // ── health ──
  lastHealthyAt     DateTime? @map("last_healthy_at")
  lastHealthCheckAt DateTime? @map("last_health_check_at")
  lastValidatedAt   DateTime? @map("last_validated_at")

  // ── bookkeeping ──
  metadataSource String   @default("seed") @map("metadata_source")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  evidence CapabilityEvidence[]

  @@index([definitionId])
  @@index([provider])
  @@index([activationState])
  @@index([activationState, provider])
  @@index([deploymentType])
  @@map("model_deployments")
}

/// One immutable revision of the router's configuration.
///
/// RoutingPolicy, the existing config aggregate, is mutated in place: there is
/// no way to see what the router was doing before an edit, and no way to roll
/// one back. Revisions here are append-only — an edit publishes revision N+1 and
/// marks N SUPERSEDED — which is also what makes optimistic concurrency
/// possible: a save carries the revision it was based on and loses the race
/// rather than silently overwriting a concurrent admin.
///
/// `scope` is GLOBAL today. routing-service has no tenant columns anywhere, so
/// per-tenant configuration needs a scoping migration first; the column exists
/// so that arrives as data rather than as a schema change.
model RouterConfiguration {
  id       String                    @id @default(cuid())
  scope    String                    @default("GLOBAL")
  revision Int
  status   RouterConfigurationStatus @default(DRAFT)

  mode    RouterConfigurationMode @default(CLOUD_FIRST)
  enabled Boolean                 @default(false)

  // ── budgets, all hard ceilings ──
  totalDeadlineMs       Int @default(5000) @map("total_deadline_ms")
  maxAttempts           Int @default(6) @map("max_attempts")
  maxRouterInputTokens  Int @default(1800) @map("max_router_input_tokens")
  maxRouterOutputTokens Int @default(320) @map("max_router_output_tokens")

  // ── decision policy ──
  minConfidence                     Decimal             @default(0.75) @map("min_confidence") @db.Decimal(4, 3)
  lowConfidenceAction               LowConfidenceAction @default(QUALITY_ESCALATION_THEN_DETERMINISTIC) @map("low_confidence_action")
  /// With no usable router, fail with a typed error rather than picking
  /// arbitrarily — an unexplained model choice is worse than an honest refusal.
  failClosedWhenNoEligibleRouter    Boolean             @default(true) @map("fail_closed_when_no_eligible_router")
  skipProviderOnProviderWideFailure Boolean             @default(true) @map("skip_provider_on_provider_wide_failure")

  safeTraceLevel             String  @default("DETAILED_FACTORS") @map("safe_trace_level")
  /// Keeps the legacy local router reachable by chain order alone, so rollback
  /// is a configuration change rather than a deploy.
  legacyLocalRollbackEnabled Boolean @default(true) @map("legacy_local_rollback_enabled")

  // ── revision bookkeeping ──
  supersedesRevision Int?      @map("supersedes_revision")
  publishedAt        DateTime? @map("published_at")
  publishedBy        String?   @map("published_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  entries RouterChainEntry[]

  @@unique([scope, revision])
  @@index([scope, status])
  @@map("router_configurations")
}

/// One ordered attempt target within a configuration revision.
///
/// Entries belong to a revision rather than to a mutable configuration, so the
/// chain a decision used can be reconstructed exactly.
model RouterChainEntry {
  id              String              @id @default(cuid())
  configurationId String              @map("configuration_id")
  configuration   RouterConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  order   Int
  enabled Boolean              @default(true)
  role    RouterChainEntryRole @default(PROVIDER_FALLBACK)

  /// The endpoint this entry calls. Nullable so a seeded bootstrap alias can be
  /// recorded before discovery has confirmed the model exists — the entry is
  /// simply not runnable until it resolves.
  deploymentId String?        @map("deployment_id")
  /// The alias the seed was written against, kept for the admin UI and for
  /// discovery to match on. Never used to call a provider directly.
  modelAlias   String         @map("model_alias")
  provider     RouterProvider

  attemptTimeoutMs Int @default(1600) @map("attempt_timeout_ms")
  retries          Int @default(0)

  /// Canonical RouterErrorCode names that route TO this entry. Empty means the
  /// entry is reachable by ordinary chain order.
  triggers                    String[] @default([])
  skipWhenProviderCircuitOpen Boolean  @default(true) @map("skip_when_provider_circuit_open")

  /// Per-entry overrides; NULL inherits the configuration.
  minConfidence   Decimal? @map("min_confidence") @db.Decimal(4, 3)
  maxCostMicroUsd BigInt?  @map("max_cost_micro_usd")

  /// Billing model of the endpoint as configured, so a subscription entry is
  /// never costed as if it were per-token.
  billingModel BillingModel @default(UNKNOWN) @map("billing_model")

  lastValidatedAt DateTime? @map("last_validated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([configurationId, order])
  @@index([configurationId, enabled])
  @@index([provider])
  @@map("router_chain_entries")
}

/// Ledger of versioned seeds that have run against this database.
///
/// routing-service's three existing seed scripts have no ledger, no lock and no
/// checksum, so a fresh deployment boots with an empty registry unless an
/// operator remembers to run them by hand. A row here makes a seed replayable
/// and observable: the same (name, version) never applies twice, and a changed
/// payload for an already-applied version surfaces as a loud mismatch rather
/// than silently overwriting admin edits.
model SeedExecution {
  id          String    @id @default(cuid())
  name        String
  version     Int
  checksum    String
  status      String
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  /// Sanitized failure reason. Never a stack trace or a provider payload.
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([name, version])
  @@index([name])
  @@index([status])
  @@map("seed_executions")
}

/// A single sourced capability claim about a definition or a deployment.
///
/// Capability flags on RouterModelRegistry are unsourced booleans: a wrong one
/// has no audit trail, no expiry and no way to tell a marketing claim from a
/// measured probe. Each row here carries its provenance, confidence and
/// staleness so ranking can discount weak evidence instead of trusting it.
model CapabilityEvidence {
  id String @id @default(cuid())

  /// Subject is EITHER a deployment or a definition. Endpoint-specific facts
  /// (this connector's tool support) hang off the deployment; model-intrinsic
  /// facts (this family reasons well) hang off the definition.
  deploymentId String?              @map("deployment_id")
  deployment   ModelDeployment?     @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  definitionId String?              @map("definition_id")
  definition   RouterModelRegistry? @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  capability String
  value      Json
  source     EvidenceSource
  /// Where the claim came from — a provider doc URL, a lab run id, an admin id.
  sourceRef  String?        @map("source_ref")
  confidence Decimal        @default(0.500) @db.Decimal(4, 3)

  observedAt DateTime  @map("observed_at")
  validFrom  DateTime? @map("valid_from")
  expiresAt  DateTime? @map("expires_at")

  benchmarkVersion String? @map("benchmark_version")
  rubricVersion    String? @map("rubric_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([deploymentId, capability])
  @@index([definitionId, capability])
  @@index([source])
  @@index([expiresAt])
  @@map("capability_evidence")
}

/// Phase 10: Learned-score table. Per-(profile, domain, taskFamily) success
/// metrics that the scoring engine reads to nudge ranking. Separate from
/// RouterModelRegistry so manual admin overrides stay clean and learning
/// can be bounded/rolled back without touching the canonical registry.
model RouterLearnedScore {
  id                String    @id @default(cuid())
  profileKey        String    @map("profile_key")
  domain            DomainTag
  taskFamily        String    @map("task_family")
  successRate       Decimal   @default(0.6) @map("success_rate") @db.Decimal(6, 4)
  feedbackPositive  Int       @default(0) @map("feedback_positive")
  feedbackNegative  Int       @default(0) @map("feedback_negative")
  judgeVerified     Int       @default(0) @map("judge_verified")
  judgeRevised      Int       @default(0) @map("judge_revised")
  judgeEscalated    Int       @default(0) @map("judge_escalated")
  fallbackTriggered Int       @default(0) @map("fallback_triggered")
  totalRoutes       Int       @default(0) @map("total_routes")
  lastUpdatedAt     DateTime  @default(now()) @map("last_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([profileKey, domain, taskFamily])
  @@index([profileKey])
  @@index([domain])
  @@map("router_learned_scores")
}

/// Phase 9: Router workflows. Multi-step pipelines the router can choose
/// instead of (or in addition to) a single LLM model.
model RouterWorkflow {
  id               String       @id @default(cuid())
  workflowKey      String       @unique @map("workflow_key")
  kind             WorkflowKind
  displayName      String       @map("display_name")
  description      String?
  steps            Json
  defaultModelTier String       @default("A") @map("default_model_tier")
  isEnabled        Boolean      @default(true) @map("is_enabled")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([kind])
  @@map("router_workflows")
}

/// Phase 12: Circuit-breaker state per provider/runtime scope.
/// Survives container restarts so a flapping provider doesn't reset on
/// every redeploy. State transitions are managed by CircuitBreakerManager.
model RouterCircuitBreaker {
  id               String    @id @default(cuid())
  scope            String    @unique
  state            String
  failureCount     Int       @default(0) @map("failure_count")
  openedAt         DateTime? @map("opened_at")
  lastTransitionAt DateTime  @default(now()) @map("last_transition_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("router_circuit_breakers")
}

/// Phase 2: Domain/Career/Major Taxonomy. One row per professional role.
/// Routes use this to map (prompt → role → expected domain + privacy default).
model TaxonomyRole {
  id             String       @id @default(cuid())
  roleKey        String       @unique @map("role_key")
  displayName    String       @map("display_name")
  industryKey    String       @map("industry_key")
  domainKey      DomainTag    @map("domain_key")
  capabilities   String[]     @default([])
  privacyDefault PrivacyClass @default(CLOUD_PERMITTED) @map("privacy_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([industryKey])
  @@index([domainKey])
  @@map("taxonomy_roles")
}

/// Per-(profile, fieldName) admin override that survives upstream sync.
/// Sync workers MUST skip writing fields that have an active override.
model RouterAdminOverride {
  id         String   @id @default(cuid())
  profileId  String   @map("profile_id")
  fieldName  String   @map("field_name")
  fieldValue Json     @map("field_value")
  reason     String?
  setBy      String   @map("set_by")
  setAt      DateTime @default(now()) @map("set_at")
  isActive   Boolean  @default(true) @map("is_active")

  profile RouterModelRegistry @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, fieldName])
  @@index([profileId])
  @@index([isActive])
  @@map("router_admin_overrides")
}

// ─────────────────────────────────────────────────────────────────────────────
// Versioned model cost accounting (payment flagship)
//
// Raw token count is not an economic unit — providers charge different rates for
// input, output, cached reads, reasoning, media and tool calls. Quota is metered
// in cost-normalized "weighted" tokens, and this table is where the cost comes
// from.
//
// Every rate is integer MICRO-USD. Floating point is banned on this path: a
// float rounding error repeated across millions of requests is a real revenue
// leak, and JS cannot represent a tenth of a cent exactly.
//
// Prices are VERSIONED, not mutated. A rate change retires the current row and
// inserts a new one, so a historical usage record can always be re-priced with
// the rates that were actually in force when it ran.
// ─────────────────────────────────────────────────────────────────────────────

enum ModelCostSource {
  SEED
  PROVIDER_SYNC
  ADMIN_OVERRIDE
  // Cost the provider itself reported for a completed call — the most accurate
  // source, used to reconcile an estimate against reality.
  PROVIDER_REPORTED
}

// Who pays for a local model's compute. Local inference is NOT free: someone
// bought the GPU and someone pays for the electricity. Only compute the USER
// owns is genuinely zero-cost to the platform.
enum LocalComputeOwnership {
  USER_OWNED
  PLATFORM_HOSTED
}

model ModelCostVersion {
  id       String @id @default(cuid())
  provider String
  modelKey String @map("model_key")
  version  Int
  currency String @default("USD")

  // Per-million-token rates, integer micro-USD. Nullable because providers
  // publish different subsets; a null rate contributes zero to the estimate and
  // LOWERS the confidence rather than silently pricing the modality as free.
  inputPerMillionMicroUsd       BigInt? @map("input_per_million_micro_usd")
  outputPerMillionMicroUsd      BigInt? @map("output_per_million_micro_usd")
  cachedInputPerMillionMicroUsd BigInt? @map("cached_input_per_million_micro_usd")
  cacheWritePerMillionMicroUsd  BigInt? @map("cache_write_per_million_micro_usd")
  reasoningPerMillionMicroUsd   BigInt? @map("reasoning_per_million_micro_usd")

  // Per-unit rates, integer micro-USD.
  imagePerUnitMicroUsd      BigInt? @map("image_per_unit_micro_usd")
  audioPerUnitMicroUsd      BigInt? @map("audio_per_unit_micro_usd")
  videoPerUnitMicroUsd      BigInt? @map("video_per_unit_micro_usd")
  toolCallPerUnitMicroUsd   BigInt? @map("tool_call_per_unit_micro_usd")
  searchCallPerUnitMicroUsd BigInt? @map("search_call_per_unit_micro_usd")

  costClass  CostClass       @default(STANDARD) @map("cost_class")
  confidence CostConfidence  @default(UNKNOWN)
  source     ModelCostSource @default(SEED)

  // An automated sync must NEVER overwrite an active administrator override.
  // Losing a hand-negotiated enterprise rate to a nightly scrape would silently
  // mis-bill every request on that model until someone noticed.
  isAdminOverride Boolean @default(false) @map("is_admin_override")

  // Local-model compute accounting. Null for cloud models.
  localComputeOwnership LocalComputeOwnership? @map("local_compute_ownership")

  isActive  Boolean @default(true) @map("is_active")
  // Emulated partial-unique index: carries "<provider>:<modelKey>" while this
  // row is the live price and NULL once retired. Postgres treats every NULL as
  // distinct, so retired rows coexist freely but a second ACTIVE price for one
  // model is rejected by the database itself.
  activeKey String? @unique @map("active_key")

  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  retiredAt       DateTime? @map("retired_at")
  lastVerifiedAt  DateTime? @map("last_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")
  notes           String?

  @@unique([provider, modelKey, version])
  @@index([provider, modelKey])
  @@index([isActive])
  @@map("model_cost_versions")
}

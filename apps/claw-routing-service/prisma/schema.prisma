  SIMPLE
  MEDIUM
  COMPLEX
  EXPERT
}

enum RoutingMode {
  AUTO
  MANUAL_MODEL
  LOCAL_ONLY
  PRIVACY_FIRST
  LOW_LATENCY
  HIGH_REASONING
  COST_SAVER
}

enum OutcomeLabel {
  CORRECT_IMPROVEMENT
  BAD_REGRESSION
  COST_WIN
  QUALITY_WIN
  UNCERTAIN
}

enum FeedbackValue {
  POSITIVE
  NEGATIVE
}

enum RoutingExecutionStatus {
  SUCCEEDED
  FAILED
  DEGRADED
  NO_EXECUTION_MODEL
}

enum JudgeOutcome {
  VERIFIED
  REVISED
  ESCALATED
  UNAVAILABLE
  NONE
}

// ─── Smart Router Flagship — Phase 1: Model Intelligence Registry ───


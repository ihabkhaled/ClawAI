generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileIngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model File {
  id                  String              @id @default(cuid())
  userId              String              @map("user_id")
  filename            String
  mimeType            String              @map("mime_type")
  sizeBytes           Int                 @map("size_bytes")
  storagePath         String              @map("storage_path")
  content             String?             @map("content")
  extractedText       String?             @map("extracted_text")
  extractionError     String?             @map("extraction_error")
  ingestionStatus     FileIngestionStatus @default(PENDING) @map("ingestion_status")
  retentionExpiresAt  DateTime?           @map("retention_expires_at")
  parentFileId        String?             @map("parent_file_id")
  isExtracted         Boolean             @default(false) @map("is_extracted")
  // Relative path of this file INSIDE its parent archive (e.g. "docs/intro.md").
  // Null for every file that was not extracted from an archive. `filename` is the
  // basename only, so without this the folder structure is lost.
  archivePath         String?             @map("archive_path")
  extractionMetadata  Json?               @map("extraction_metadata")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  chunks FileChunk[]

  @@index([userId])
  @@index([ingestionStatus])
  @@index([retentionExpiresAt])
  @@index([parentFileId])
  @@map("files")
}

model FileChunk {
  id         String   @id @default(cuid())
  fileId     String   @map("file_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([chunkIndex])
  @@map("file_chunks")
}

// A scrubbed text file the coding agent published as a hosted page (F025).
//
// `publicId` is the ONLY thing a stranger can address it by: 192 random bits,
// base64url. The row id stays owner-side (list/delete). Content is plain UTF-8
// text, capped at 1 MiB by the service, and is always served back as
// text/plain — see docs/04-backend/service-guide-file-service.md.
model PublishedArtifact {
  id        String   @id @default(cuid())
  publicId  String   @unique @map("public_id")
  userId    String   @map("user_id")
  title     String?
  filename  String
  mimeType  String   @map("mime_type")
  content   String
  sizeBytes Int      @map("size_bytes")
  sha256    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("published_artifacts")
}

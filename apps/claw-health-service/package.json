{
  "name": "claw-health-service",
  "version": "1.108.6",
  "private": true,
  "description": "Claw Health Service - Aggregated health checks for all microservices",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --delay 1500ms --signal SIGTERM --exec \"npm run build && node dist/main.js\"",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/ --concurrency=4",
    "lint:strict": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "validate": "npm run typecheck && npm run lint:strict && npm run format:check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@claw/shared-utilities": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "axios": "^1.20.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "74.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "5.0.1"
  },
  "type": "module"
}

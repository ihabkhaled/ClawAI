{
  "name": "claw-health-service",
  "version": "1.22.0",
  "private": true,
  "description": "Claw Health Service - Aggregated health checks for all microservices",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --delay 1500ms --signal SIGTERM --exec \"npm run build && node dist/main.js\"",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/ --concurrency=4",
    "lint:strict": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "validate": "npm run typecheck && npm run lint:strict && npm run format:check",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@claw/shared-utilities": "*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "axios": "^1.19.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "73.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}

FROM node:26-alpine
RUN apk add --no-cache openssl
WORKDIR /app

# Copy entire monorepo structure for workspace resolution.
COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/claw-audit-service/ ./apps/claw-audit-service/

# Install everything at workspace root so transitive types (express,
# @types/*, etc.) needed by shared packages are hoisted to /app/node_modules.
# Root package.json declares
# `overrides: { "@nestjs/schematics": { "typescript": "6.0.0-beta" } }`
# which reconciles the peer constraint at lock-file level — no
# --legacy-peer-deps required.
RUN npm install --ignore-scripts

# Build shared packages.
RUN cd packages/shared-types && npx tsc \
 && cd ../shared-constants && npx tsc \
 && cd ../shared-rabbitmq && npx tsc \
 && cd ../shared-auth && npx tsc \
 && cd ../shared-utilities && npx tsc

WORKDIR /app/apps/claw-audit-service
RUN chmod +x docker-entrypoint.dev.sh 2>/dev/null || true

EXPOSE 4007
CMD ["./docker-entrypoint.dev.sh"]

FROM node:20-alpine
RUN apk add --no-cache openssl
WORKDIR /app

# Copy entire monorepo structure for workspace resolution.
COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/claw-audit-service/ ./apps/claw-audit-service/

# Build shared packages first so the service can import their dist/.
RUN cd packages/shared-types && npm install --ignore-scripts && npx tsc
RUN cd packages/shared-constants && npm install --ignore-scripts && npx tsc
RUN cd packages/shared-rabbitmq && npm install --ignore-scripts && npx tsc
RUN cd packages/shared-auth && npm install --ignore-scripts && npx tsc
RUN cd packages/shared-utilities && npm install --ignore-scripts && npx tsc

# Install service dependencies. Root package.json declares
# `overrides: { "@nestjs/schematics": { "typescript": "6.0.0-beta" } }`
# so npm reconciles the peer constraint without --legacy-peer-deps.
WORKDIR /app/apps/claw-audit-service
RUN npm install --ignore-scripts
RUN chmod +x docker-entrypoint.dev.sh 2>/dev/null || true

EXPOSE 4007
CMD ["./docker-entrypoint.dev.sh"]

{
  "name": "claw-frontend",
  "version": "1.212.3",
  "private": true,
  "scripts": {
    "clear-cache": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "marketing:shots": "node scripts/marketing-shots/capture.cjs",
    "dev": "npm run clear-cache && next dev --turbopack --port 3000",
    "dev:docker": "next dev --turbopack --port 3000",
    "build": "npm run clear-cache && next build --turbopack",
    "start": "next start",
    "lint": "eslint src/ --concurrency=4 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:strict": "next lint && eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "typecheck": "node scripts/typecheck-ts7.mjs --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "validate": "npm run typecheck && npm run lint:strict && npm run format:check",
    "test": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@claw/shared-constants": "*",
    "@claw/shared-types": "*",
    "@claw/shared-utilities": "*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.16",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@swc/core": "^1.16.17",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unicorn": "77.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.29",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "typescript7": "npm:typescript@7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 iOS versions",
    "not dead"
  ]
}

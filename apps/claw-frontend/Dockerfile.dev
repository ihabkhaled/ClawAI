FROM node:26-alpine
WORKDIR /app
COPY package.json ./
COPY .husky/install.mjs ./.husky/install.mjs
RUN npm install --legacy-peer-deps
COPY . .
# Remove any empty app/ directory that would shadow src/app/ in Next.js
RUN rmdir /app/app 2>/dev/null || true
EXPOSE 3000
# Turbopack enabled via --turbopack in package.json dev script
CMD ["npm", "run", "dev"]

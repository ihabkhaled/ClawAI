  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3000",
      "startServerReadyPattern": "Local:|Ready in|started server",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/en/about",
        "http://localhost:3000/en/acceptable-use",
        "http://localhost:3000/en/features",
        "http://localhost:3000/en/how-it-works",
        "http://localhost:3000/en/architecture",
        "http://localhost:3000/en/use-cases",
        "http://localhost:3000/en/faq",
        "http://localhost:3000/en/local-first-ai",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/en/cookies",
        "http://localhost:3000/en/pricing",
        "http://localhost:3000/en/privacy",
        "http://localhost:3000/en/security-and-privacy",
        "http://localhost:3000/en/supported-models",
        "http://localhost:3000/en/terms",
        "http://localhost:3000/en/compare",
        "http://localhost:3000/en/compare/chatgpt",
        "http://localhost:3000/en/compare/claude",
        "http://localhost:3000/en/compare/gemini",
        "http://localhost:3000/en/compare/perplexity",
        "http://localhost:3000/en/compare/copilot",
        "http://localhost:3000/en/compare/kimi",
        "http://localhost:3000/en/compare/qwen",
        "http://localhost:3000/en/compare/glm",
        "http://localhost:3000/en/compare/deepseek",
        "http://localhost:3000/en/coding-agent",
        "http://localhost:3000/en/coding-agent/install",
        "http://localhost:3000/en/learn",
        "http://localhost:3000/en/learn/what-is-multi-model-ai",
        "http://localhost:3000/en/learn/what-is-llm-orchestration",
        "http://localhost:3000/en/learn/what-is-ai-model-routing",
        "http://localhost:3000/en/learn/what-is-model-fallback",
        "http://localhost:3000/en/learn/what-is-ai-consensus",
        "http://localhost:3000/en/learn/what-is-best-of-n",
        "http://localhost:3000/en/learn/what-is-an-ai-judge",
        "http://localhost:3000/en/learn/what-is-ai-answer-verification",
        "http://localhost:3000/en/learn/what-is-a-context-window",
        "http://localhost:3000/en/learn/what-is-rag",
        "http://localhost:3000/en/learn/what-is-ai-memory",
        "http://localhost:3000/en/learn/what-are-context-packs",
        "http://localhost:3000/en/learn/what-is-local-ai",
        "http://localhost:3000/en/learn/what-are-open-weight-models",
        "http://localhost:3000/en/learn/what-is-self-hosted-ai",
        "http://localhost:3000/en/learn/ollama-vs-llamacpp",
        "http://localhost:3000/en/learn/cloud-ai-vs-local-ai",
        "http://localhost:3000/en/learn/ai-agent-vs-ai-chatbot",
        "http://localhost:3000/en/integrations",
        "http://localhost:3000/en/integrations/github",
        "http://localhost:3000/en/integrations/gitlab",
        "http://localhost:3000/en/integrations/bitbucket",
        "http://localhost:3000/en/integrations/slack",
        "http://localhost:3000/en/integrations/jira",
        "http://localhost:3000/en/integrations/confluence",
        "http://localhost:3000/en/integrations/figma",
        "http://localhost:3000/en/integrations/clickup",
        "http://localhost:3000/en/integrations/google-drive",
        "http://localhost:3000/en/integrations/gmail",
        "http://localhost:3000/en/integrations/microsoft-sharepoint",
        "http://localhost:3000/en/integrations/microsoft-onedrive",
        "http://localhost:3000/en/integrations/google-calendar",
        "http://localhost:3000/en/integrations/outlook-calendar"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "meta-description": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "is-crawlable": "error",
        "csp-xss": "warn",
        "color-contrast": "error",
        "image-alt": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

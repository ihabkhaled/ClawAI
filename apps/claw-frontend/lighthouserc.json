{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3000",
      "startServerReadyPattern": "Local:|Ready in|started server",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/en/about",
        "http://localhost:3000/en/acceptable-use",
        "http://localhost:3000/en/features",
        "http://localhost:3000/en/how-it-works",
        "http://localhost:3000/en/architecture",
        "http://localhost:3000/en/use-cases",
        "http://localhost:3000/en/faq",
        "http://localhost:3000/en/local-first-ai",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/en/cookies",
        "http://localhost:3000/en/pricing",
        "http://localhost:3000/en/privacy",
        "http://localhost:3000/en/security-and-privacy",
        "http://localhost:3000/en/supported-models",
        "http://localhost:3000/en/terms",
        "http://localhost:3000/en/compare",
        "http://localhost:3000/en/compare/chatgpt",
        "http://localhost:3000/en/compare/claude",
        "http://localhost:3000/en/compare/gemini",
        "http://localhost:3000/en/compare/perplexity",
        "http://localhost:3000/en/compare/copilot"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "meta-description": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "is-crawlable": "error",
        "csp-xss": "warn",
        "color-contrast": "error",
        "image-alt": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

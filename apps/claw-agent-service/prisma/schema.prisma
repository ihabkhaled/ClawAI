generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentSessionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
}

enum TerminalCommandStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  EXECUTED
  FAILED
  EXPIRED
  CANCELLED
}

enum FileEventType {
  CREATED
  MODIFIED
  DELETED
  RENAMED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum RefreshTokenStatus {
  ACTIVE
  USED
  REVOKED
}

enum PairingStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED
}

enum DeviceCodeStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED
}

enum PolicyKind {
  ALLOW
  DENY
  AUTO_APPROVE
}

enum RiskLabel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScheduledCommandStatus {
  ENABLED
  PAUSED
  DISABLED
}

/// F099: COMMAND runs a shell command on a paired device; PROMPT runs an agent
/// prompt on an online registered runner whose labels match.
enum ScheduledCommandKind {
  COMMAND
  PROMPT
}

/// F099: SHELL is a command line; PROMPT is an agent prompt a runner executes
/// through the headless SDK under its own local approval policy.
enum TerminalCommandKind {
  SHELL
  PROMPT
}

// === Capability Framework (Stream 10 — flagship) ===
//
// Generalises the existing terminal-command approval flow into a unified
// Capability layer that every later stream (filesystem, process, browser,
// screen, clipboard, application, audio, recipe step) plugs into.
// Existing TerminalCommand flow stays for back-compat; under dual-write
// every new TerminalCommand also creates a CapabilityInvocation row whose
// `metadata.legacyTerminalCommandId` references it.
enum CapabilityClass {
  TERMINAL
  FILESYSTEM
  PROCESS
  BROWSER
  SCREEN
  CLIPBOARD
  NOTIFICATION
  APPLICATION
  AUDIO
  SYSTEM
  RECIPE_STEP
}

enum CapabilityOperation {
  // Generic + per-class subsets used. Names line up with the per-class
  // capability provider operation files in agent-cli/src/capability-providers/.
  READ
  WRITE
  APPEND
  MOVE
  DELETE
  LIST
  STAT
  WATCH
  SEARCH
  DIFF
  MKDIR
  SPAWN
  KILL
  SIGNAL
  SET_ENV
  TAIL_OUTPUT
  OPEN
  NAVIGATE
  CLICK
  FILL
  SCROLL
  SCREENSHOT
  EXTRACT_TEXT
  UPLOAD_FILE
  DOWNLOAD
  NETWORK_TRACE
  INTERCEPT
  COOKIE_READ
  COOKIE_CLEAR
  SESSION_SAVE
  SESSION_RESTORE
  CAPTURE_FULL
  CAPTURE_REGION
  CAPTURE_WINDOW
  OCR
  COLOR_PICK
  FIND_IMAGE
  RECORD_VIDEO
  COMPARE_REGIONS
  GET_TEXT
  SET_TEXT
  GET_IMAGE
  PUSH
  POP
  HISTORY
  SHOW_TOAST
  SHOW_MODAL
  SHOW_TRAY
  LAUNCH
  ACTIVATE
  QUIT
  LIST_RUNNING
  LIST_INSTALLED
  SEND_KEYSTROKE
  CLICK_ELEMENT
  READ_ELEMENT
  FIND_WINDOW
  TRANSCRIBE_FILE
  TRANSCRIBE_MIC
  SYNTHESISE
  PLAY
  RECORD
  NETWORK_INFO
  DISK_USAGE
  TIMEZONE
  LOCK
  SUSPEND
  COMPOSITE
}

enum CapabilityBlastRadius {
  NONE
  SINGLE_RESOURCE
  MANY_RESOURCES
  USER_SCOPE
  SYSTEM_SCOPE
  EXTERNAL
}

enum CapabilityReversibility {
  REVERSIBLE
  COMPENSATABLE
  IRREVERSIBLE
}

enum CapabilityInvocationStatus {
  PENDING_APPROVAL
  AUTO_APPROVED
  APPROVED
  EXECUTING
  EXECUTED
  FAILED
  REJECTED
  EXPIRED
  CANCELLED
  ROLLED_BACK
  ROLLBACK_FAILED
  DENIED
}

enum RecipeRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum RecipeRunStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

// Stream 40 — fleet admin
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

// V2 Stream 05 — activity-driven suggestion lifecycle
enum AgentSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

// Stream 42 — marketplace
enum MarketplaceListingStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

model AgentSession {
  id              String             @id @default(cuid())
  userId          String
  deviceId        String?
  device          Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sessionKey      String             @unique
  deprecatedKey   Boolean            @default(false)
  hostname        String
  platform        String
  agentVersion    String
  status          AgentSessionStatus @default(CONNECTED)
  lastHeartbeatAt DateTime?
  connectedAt     DateTime           @default(now())
  disconnectedAt  DateTime?
  metadata        Json?
  /// F100: last runner-policy verdict ('compliant' | 'noncompliant' | 'unknown'); NULL = not evaluated.
  runnerCompliance       String?
  /// F100: comma-separated reason codes for a non-compliant or unknown verdict.
  runnerComplianceReason String?
  commands        TerminalCommand[]
  runnerCredential RunnerCredential?
  repos           LocalRepo[]
  fileEvents      FileWatchEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, status])
  @@index([sessionKey])
  @@index([deviceId])
  @@map("agent_sessions")
}

model Device {
  id           String       @id @default(cuid())
  userId       String
  orgId        String?
  name         String
  hostname     String
  os           String
  platform     String
  agentVersion String
  scopesCsv    String
  status       DeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?
  lastIp       String?
  revokedAt    DateTime?
  revokeReason String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions          AgentSession[]
  refreshTokens     RefreshToken[]
  scheduledCommands ScheduledCommand[]

  @@index([userId, status])
  @@index([userId, lastSeenAt])
  @@map("devices")
}

model RefreshToken {
  id           String             @id @default(cuid())
  deviceId     String
  device       Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash    String             @unique
  jti          String             @unique
  status       RefreshTokenStatus @default(ACTIVE)
  expiresAt    DateTime
  usedAt       DateTime?
  replacedById String?
  replacedBy   RefreshToken?      @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  ancestors    RefreshToken[]     @relation("RefreshTokenReplacement")
  createdAt    DateTime           @default(now())
  lastUsedIp   String?

  @@index([deviceId, status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PairingRequest {
  id                String        @id @default(cuid())
  codeHash          String        @unique
  stateNonce        String
  deviceHint        Json
  loopbackPort      Int?
  status            PairingStatus @default(PENDING)
  approvedByUserId  String?
  approvedDeviceId  String?
  approvedScopesCsv String?
  expiresAt         DateTime
  createdAt         DateTime      @default(now())
  consumedAt        DateTime?

  @@index([status, expiresAt])
  @@map("pairing_requests")
}

model DeviceCodeRequest {
  id                String           @id @default(cuid())
  userCode          String           @unique
  deviceCodeHash    String           @unique
  deviceHint        Json
  intervalSeconds   Int              @default(5)
  slowDownUntil     DateTime?
  offenceCount      Int              @default(0)
  status            DeviceCodeStatus @default(PENDING)
  approvedByUserId  String?
  approvedDeviceId  String?
  approvedScopesCsv String?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  consumedAt        DateTime?

  @@index([status, expiresAt])
  @@map("device_code_requests")
}

model TerminalCommand {
  id              String                @id @default(cuid())
  sessionId       String
  session         AgentSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  command         String
  workingDir      String?
  /// F099: PROMPT jobs carry the prompt in `command`, plus model and repository.
  kind            TerminalCommandKind   @default(SHELL)
  model           String?
  repoRef         String?
  status          TerminalCommandStatus @default(PENDING_APPROVAL)
  riskScore       Int                   @default(0)
  riskLabel       RiskLabel             @default(LOW)
  matchedPolicyId String?
  matchedPolicy   AccessPolicy?         @relation(fields: [matchedPolicyId], references: [id], onDelete: SetNull)
  riskReasons     String?
  autoApproved    Boolean               @default(false)
  blockedByPolicy Boolean               @default(false)
  stdout          String?
  stderr          String?
  exitCode        Int?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelRequested Boolean               @default(false)
  rejectionReason String?
  /// F099 step 2: the routine a PROMPT job came from, and what fired it (SCHEDULE, MANUAL, WEBHOOK).
  /// Together they decide, at claim time, whether the runner is handed the routine's secrets.
  routineId       String?
  routineRunSource String?
  timeoutSeconds  Int                   @default(300)
  requestedAt     DateTime              @default(now())
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([sessionId, status])
  @@index([userId, status])
  @@index([matchedPolicyId])
  @@map("terminal_commands")
}

model ScheduledCommand {
  id            String                 @id @default(cuid())
  userId        String
  /// Null for PROMPT routines: they go to a runner, not to a paired device.
  deviceId      String?
  device        Device?                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name          String
  kind          ScheduledCommandKind   @default(COMMAND)
  /// The shell command, or the agent prompt for a PROMPT routine.
  command       String
  model         String?
  repoRef       String?
  runnerLabels  String[]               @default([])
  workingDir    String?
  intervalMinutes Int
  /// F099: five-field cron read in UTC (PROMPT routines). When set it decides
  /// `nextRunAt` and `intervalMinutes` is an unused placeholder.
  cron          String?
  /// F099: when true a signed webhook can fire this PROMPT routine now. Off by
  /// default, so no existing routine gains a public entry point.
  webhookEnabled       Boolean @default(false)
  /// F099: the webhook secret is derived from this, never stored; bumping it
  /// retires the previous secret.
  webhookSecretVersion Int     @default(0)
  /// F099 step 2: when true a webhook-fired run also receives this routine's secrets.
  /// Off by default: the owner opts in, because the webhook is a public entry point.
  webhookSecretsEnabled Boolean @default(false)
  secrets       RoutineSecret[]
  status        ScheduledCommandStatus @default(ENABLED)
  lastRunAt     DateTime?
  lastCommandId String?
  nextRunAt     DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([deviceId, status])
  @@index([nextRunAt, status])
  @@map("scheduled_commands")
}

/// F099 step 2: a secret one routine can read. Only ciphertext is stored (AES-256-GCM, the
/// service ENCRYPTION_KEY, per-row random nonce). The additional authenticated data binds
/// routineId + userId + name, so a row copied to another routine fails to decrypt.
model RoutineSecret {
  id         String           @id @default(cuid())
  routineId  String
  routine    ScheduledCommand @relation(fields: [routineId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  ciphertext String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([routineId, name])
  @@index([userId])
  @@map("routine_secrets")
}

/// F100: a runner's own credential, separate from the user's token. Only the
/// SHA-256 of the token is stored; the token is shown once at issue or rotation.
model RunnerCredential {
  id          String       @id @default(cuid())
  sessionId   String       @unique
  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  tokenHash   String       @unique
  tokenPrefix String
  issuedAt    DateTime     @default(now())
  rotatedAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([userId])
  @@map("runner_credentials")
}

model AccessPolicy {
  id                       String                 @id @default(cuid())
  name                     String
  kind                     PolicyKind
  pattern                  String
  scope                    String?
  riskScore                Int                    @default(0)
  riskLabel                RiskLabel              @default(LOW)
  description              String?
  priority                 Int                    @default(0)
  isActive                 Boolean                @default(true)
  orgId                    String?
  // === Capability framework extensions (Stream 10) ===
  // null capabilityClass = legacy terminal-command policy; non-null = new path.
  capabilityClass          CapabilityClass?
  capabilityOperation      CapabilityOperation?
  targetMatcherJson        Json?
  autoApproveMaxRiskScore  Int?
  requireReason            Boolean                @default(false)
  isSystemDefault          Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  commands     TerminalCommand[]
  invocations  CapabilityInvocation[]

  @@index([kind, isActive, priority])
  @@index([orgId])
  @@index([capabilityClass, capabilityOperation, isActive, priority])
  @@map("access_policies")
}

// CapabilityInvocation is the unified record for every approval-gated agent
// action (Stream 10). For TERMINAL class it dual-writes alongside
// TerminalCommand during a deprecation window controlled by
// CAPABILITY_DEPRECATED_TERMINAL_COMMAND_DUAL_WRITE.
model CapabilityInvocation {
  id                    String                       @id @default(cuid())
  userId                String
  deviceId              String
  recipeRunId           String?
  parentInvocationId    String?
  capabilityClass       CapabilityClass
  capabilityOperation   CapabilityOperation
  targetDescriptor      Json
  requiredScopes        Json
  blastRadius           CapabilityBlastRadius
  reversibility         CapabilityReversibility
  payload               Json
  status                CapabilityInvocationStatus   @default(PENDING_APPROVAL)
  riskScore             Int                          @default(0)
  riskLabel             RiskLabel                    @default(LOW)
  matchedPolicyId       String?
  matchedPolicy         AccessPolicy?                @relation(fields: [matchedPolicyId], references: [id], onDelete: SetNull)
  matchedPolicyName     String?
  reviewedBy            String?
  reviewedAt            DateTime?
  rejectionReason       String?
  expiresAt             DateTime
  startedExecutingAt    DateTime?
  completedAt           DateTime?
  executionResult       Json?
  executionError        String?
  undoPlan              Json?
  rolledBackAt          DateTime?
  rollbackResult        Json?
  rollbackError         String?
  metadata              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  parent   CapabilityInvocation?  @relation("CapabilityInvocationParent", fields: [parentInvocationId], references: [id], onDelete: SetNull)
  children CapabilityInvocation[] @relation("CapabilityInvocationParent")

  @@index([userId, status])
  @@index([deviceId, status])
  @@index([recipeRunId])
  @@index([status, expiresAt])
  @@index([capabilityClass, capabilityOperation])
  @@index([matchedPolicyId])
  @@map("capability_invocations")
}

model LocalRepo {
  id            String       @id @default(cuid())
  sessionId     String
  session       AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  repoPath      String
  name          String
  branch        String?
  commitHash    String?
  isDirty       Boolean      @default(false)
  fileCount     Int          @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@map("local_repos")
}

model FileWatchEvent {
  id        String        @id @default(cuid())
  sessionId String
  session   AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  eventType FileEventType
  filePath  String
  repoId    String?
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("file_watch_events")
}

model Recipe {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  dsl         Json
  isEnabled   Boolean  @default(true)
  version     Int      @default(1)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs RecipeRun[]

  @@unique([userId, name])
  @@index([userId, isEnabled])
  @@map("recipes")
}

model RecipeRun {
  id          String          @id @default(cuid())
  recipeId    String
  recipe      Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId      String
  deviceId    String
  status      RecipeRunStatus @default(PENDING)
  params      Json
  // V2 Stream 01 — dryRun runs propose-and-skip every step instead of
  // actually invoking the capability framework. Step rows are still
  // created so the visual builder's preview UI can show the resolved
  // target/payload for each step. metadata.dryRun=true is set on the
  // run itself and on each step row.
  dryRun      Boolean         @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  errorMessage String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  steps RecipeRunStep[]

  @@index([userId, status])
  @@index([recipeId, createdAt])
  @@index([status, startedAt])
  @@map("recipe_runs")
}

model RecipeRunStep {
  id              String              @id @default(cuid())
  recipeRunId     String
  run             RecipeRun           @relation(fields: [recipeRunId], references: [id], onDelete: Cascade)
  stepId          String
  stepIndex       Int
  status          RecipeRunStepStatus @default(PENDING)
  invocationId    String?
  output          Json?
  errorMessage    String?
  metadata        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([recipeRunId, stepId])
  @@index([recipeRunId, stepIndex])
  @@map("recipe_run_steps")
}

// ============================================================================
// Stream 40 — Multi-device fleet admin
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ssoEnabled Boolean @default(false)
  ssoMetadataJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  policy  OrganizationPolicy?

  @@map("organizations")
}

/// The policy an organization imposes on its members' coding-agent clients.
///
/// Every field narrows what a client may do and none widens it, which is what
/// makes it safe to deliver over an authenticated HTTPS request rather than as
/// a signed document: a forged policy could only refuse work, never grant it.
/// A signed distribution would additionally survive a compromised backend, and
/// is deliberately left for the day that threat is in scope — entitlements,
/// which gate money, already arrive the same way.
model OrganizationPolicy {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Empty means every tool is allowed; a non-empty list is exhaustive.
  allowedTools  String[] @default([])
  /// Empty means every model is allowed; a non-empty list is exhaustive.
  allowedModels String[] @default([])
  /// Highest risk class a member may reach: R0 through R4.
  maximumRisk   String   @default("R4")
  /// Effects that are refused outright, by the client's effect taxonomy.
  deniedEffects String[] @default([])
  /// Effects that always require an explicit approval, even in automatic modes.
  requireApproval String[] @default([])
  /// 0 means the client keeps nothing durable it does not have to.
  maximumRetentionDays Int @default(3650)
  /// When set, members cannot select a weaker permission mode than this one.
  minimumPermissionMode String?
  /// F053 hard deny/ask rules, the extension's `policyRuleSchema` shape. Validated on write.
  rules      Json @default("[]")
  /// F053 trust lists: { repositories, domains, commands } glob arrays; empty constrains nothing.
  trust      Json @default("{\"repositories\":[],\"domains\":[],\"commands\":[]}")
  /// F054 MCP server patterns: { allow, deny }; deny wins, empty allow admits every server.
  mcpServers Json @default("{\"allow\":[],\"deny\":[]}")
  /// F081: the only plugin marketplaces members may install from. NULL means the
  /// organization has no opinion; `[]` means none is allowed (the client's reading).
  allowedPluginMarketplaces Json?
  /// F100: oldest runner version members' self-hosted runners may report (semver). NULL = no opinion.
  /// Self-reported and unsigned: it detects stale runners, it does not prove identity.
  minRunnerVersion String?
  /// F100: runner platforms allowed (normalized names). NULL = no opinion; `[]` is refused on write.
  allowedRunnerPlatforms Json?
  /// F100: 'off' (default, nothing evaluated) | 'report' (flag, never refuse) | 'enforce' (refuse).
  runnerPolicyMode String @default("off")
  /// F100: in enforce mode, also refuse a runner that reports nothing to check against.
  requireVersionReport Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_policies")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ============================================================================
// Stream 41 — Activity memory (local-first; sync flag opt-in)
// ============================================================================

model ActivityMemoryEntry {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  kind         String   // free-form classifier (e.g. 'capability_executed', 'shell_session', 'browser_focus')
  summary      String   @db.Text
  occurredAt   DateTime
  syncedToCloud Boolean @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([userId, kind, occurredAt])
  @@map("activity_memory_entries")
}

// V2 Stream 05 — activity-driven suggestions.
//
// AgentSuggestionManager scans activity_memory_entries on a cron and
// emits a row here whenever a (userId, kind) pair crosses an
// occurrence threshold in the rolling 7-day window. The frontend lists
// PENDING rows and the user accepts (creating a real Recipe) or
// dismisses them. EXPIRED rows are swept after 14 days untouched.
model AgentSuggestion {
  id                    String                @id @default(cuid())
  userId                String
  kind                  String                // mirrors ActivityMemoryEntry.kind
  summary               String                @db.Text
  occurrencesLast7d     Int
  sourceActivityIds     Json                  // array of cuid strings, capped at 50
  suggestedRecipeDsl    Json?                 // optional pre-rendered DSL the user can accept
  status                AgentSuggestionStatus @default(PENDING)
  reviewedAt            DateTime?
  reviewedByUserId      String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([userId, kind, status])
  @@index([userId, status, createdAt])
  @@map("agent_suggestions")
}

// ============================================================================
// Stream 42 — Recipe marketplace (Ed25519-signed)
// ============================================================================

model MarketplaceListing {
  id              String                   @id @default(cuid())
  publisherUserId String
  recipeId        String?
  name            String
  description     String?                  @db.Text
  dsl             Json
  signaturePublicKey String                // Ed25519 public key (hex)
  signature       String                   // Ed25519 signature over canonical(dsl) (hex)
  signatureAlgorithm String                @default("ed25519")
  status          MarketplaceListingStatus @default(DRAFT)
  installs        Int                      @default(0)
  metadata        Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([publisherUserId, name])
  @@index([status, createdAt])
  @@map("marketplace_listings")
}

model MarketplaceInstall {
  id          String   @id @default(cuid())
  listingId   String
  userId      String
  recipeId    String?  // populated after the install creates a local Recipe
  installedAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([userId])
  @@map("marketplace_installs")
}

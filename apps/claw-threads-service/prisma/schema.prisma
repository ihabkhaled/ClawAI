generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  DRAFT
  READY_FOR_REVIEW
  PUBLISHED
  UNPUBLISHED
  REVOKED
}

enum RevisionReviewStatus {
  PENDING
  READY_FOR_REVIEW
  OWNER_APPROVED
  STALE
}

enum PublicationSafetyStatus {
  APPROVED
  REVIEW_REQUIRED
}

enum PublicationCommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum PublicationReactionValue {
  LIKE
  DISLIKE
}

enum PublicationChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  APPLIED
}

enum PublicationReportReason {
  SPAM
  ABUSE
  PRIVATE_INFORMATION
  UNSAFE_CONTENT
  OTHER
}

enum PublicationReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ThreadPublication {
  id               String                           @id @default(cuid())
  ownerId          String?                          @map("owner_id")
  slug             String                           @unique
  status           PublicationStatus                @default(DRAFT)
  generationJobId  String?                          @unique @map("generation_job_id")
  contentLocale    String                           @default("en") @map("content_locale")
  publicationType  String                           @default("article") @map("publication_type")
  sourceSnapshot   Json?                            @map("source_snapshot")
  sourceHash       String?                          @map("source_hash")
  /// Hash of the owner's start idempotency key; with `ownerId` it makes a repeated start return this row (ADR-176).
  startKeyHash     String?                          @map("start_key_hash")
  /// Hash of the start request body (without keys), so a reused key with another body is a 409.
  startRequestHash String?                          @map("start_request_hash")
  publishedAt      DateTime?                        @map("published_at")
  /// Human views (crawlers and repeats inside the dedupe window are not counted).
  viewCount        Int                              @default(0) @map("view_count")
  /// Distinct signed-in readers. A count only: who they are is never exposed.
  readerCount      Int                              @default(0) @map("reader_count")
  createdAt        DateTime                         @default(now()) @map("created_at")
  updatedAt        DateTime                         @updatedAt @map("updated_at")
  views            ThreadPublicationView[]
  readers          ThreadPublicationReader[]
  revisions        ThreadPublicationRevision[]
  comments         ThreadPublicationComment[]
  reactions        ThreadPublicationReaction[]
  changeRequests   ThreadPublicationChangeRequest[]
  reports          ThreadPublicationReport[]
  formatPasses     ThreadFormatPass[]
  searchDoc        ThreadPublicationSearchDoc?

  @@unique([ownerId, startKeyHash])
  @@index([ownerId, createdAt])
  @@index([status, publishedAt])
  @@map("thread_publications")
}

/// One counted view. `viewerHash` is a keyed hash of the visitor, kept only to dedupe repeats
/// inside a short window; rows are purged after 30 days and the counters stay.
model ThreadPublicationView {
  id            String            @id @default(cuid())
  publicationId String            @map("publication_id")
  publication   ThreadPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  viewerHash    String            @map("viewer_hash")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([publicationId, viewerHash, createdAt])
  @@index([createdAt])
  @@map("thread_publication_views")
}

/// A distinct signed-in reader of one publication, by keyed hash only (deleted with the account).
model ThreadPublicationReader {
  publicationId String            @map("publication_id")
  publication   ThreadPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  readerHash    String            @map("reader_hash")
  firstSeenAt   DateTime          @default(now()) @map("first_seen_at")

  @@id([publicationId, readerHash])
  @@index([readerHash])
  @@map("thread_publication_readers")
}

/// Hashed tombstone prevents late queued work from recreating deleted account data.
model ThreadDeletedAccount {
  accountHash String   @id @map("account_hash")
  eventId     String   @unique @map("event_id")
  deletedAt   DateTime @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("thread_deleted_accounts")
}

model ThreadPublicationRevision {
  id                 String                  @id @default(cuid())
  publicationId      String                  @map("publication_id")
  publication        ThreadPublication       @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  revision           Int
  title              String
  content            Json
  contentHash        String                  @map("content_hash")
  reviewStatus       RevisionReviewStatus    @default(PENDING) @map("review_status")
  judgeScore         Int?                    @map("judge_score")
  criticScore        Int?                    @map("critic_score")
  validatedAt        DateTime?               @map("validated_at")
  ownerApprovedAt    DateTime?               @map("owner_approved_at")
  editIdempotencyKey String?                 @unique @map("edit_idempotency_key")
  editRequestHash    String?                 @map("edit_request_hash")
  revalidationJobId  String?                 @map("revalidation_job_id")
  safetyStatus       PublicationSafetyStatus @default(REVIEW_REQUIRED) @map("safety_status")
  safetyReasons      Json                    @default("[]") @map("safety_reasons")
  indexEligible      Boolean                 @default(false) @map("index_eligible")
  createdAt          DateTime                @default(now()) @map("created_at")

  @@unique([publicationId, revision])
  @@index([publicationId, reviewStatus])
  @@map("thread_publication_revisions")
}

model ThreadPublicationComment {
  id            String                             @id @default(cuid())
  publicationId String                             @map("publication_id")
  publication   ThreadPublication                  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  authorId      String?                            @map("author_id")
  /// The comment this one answers (null for a top-level comment).
  parentId      String?                            @map("parent_id")
  parent        ThreadPublicationComment?          @relation("CommentParent", fields: [parentId], references: [id], onDelete: Cascade)
  children      ThreadPublicationComment[]         @relation("CommentParent")
  /// The top-level comment of the conversation, derived on the server (null for a top-level comment).
  rootId        String?                            @map("root_id")
  root          ThreadPublicationComment?          @relation("CommentRoot", fields: [rootId], references: [id], onDelete: Cascade)
  replies       ThreadPublicationComment[]         @relation("CommentRoot")
  /// Author of the comment replied to, kept so "replying to @name" survives a parent edit; null once deleted.
  replyToUserId String?                            @map("reply_to_user_id")
  content       String                             @db.VarChar(5000)
  status        PublicationCommentStatus           @default(VISIBLE)
  createdAt     DateTime                           @default(now()) @map("created_at")
  updatedAt     DateTime                           @updatedAt @map("updated_at")
  reports       ThreadPublicationReport[]
  reactions     ThreadPublicationCommentReaction[]
  mentions      ThreadPublicationCommentMention[]

  @@index([publicationId, status, createdAt])
  @@index([publicationId, rootId, createdAt])
  @@index([rootId, status, createdAt, id])
  @@index([parentId])
  @@index([authorId, createdAt])
  @@map("thread_publication_comments")
}

/// One like or dislike of one comment by one signed-in user (ADR-179). Deleted with the account.
model ThreadPublicationCommentReaction {
  id        String                   @id @default(cuid())
  commentId String                   @map("comment_id")
  comment   ThreadPublicationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String                   @map("user_id")
  value     PublicationReactionValue
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  @@unique([commentId, userId])
  @@index([commentId, value])
  @@index([userId])
  @@map("thread_publication_comment_reactions")
}

/// A resolved @mention: only an existing, active account other than the author. The username is a
/// snapshot for linking; the row is deleted with the mentioned account.
model ThreadPublicationCommentMention {
  commentId String                   @map("comment_id")
  comment   ThreadPublicationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String                   @map("user_id")
  username  String
  createdAt DateTime                 @default(now()) @map("created_at")

  @@id([commentId, userId])
  @@index([userId])
  @@map("thread_publication_comment_mentions")
}

model ThreadPublicationReaction {
  id            String                   @id @default(cuid())
  publicationId String                   @map("publication_id")
  publication   ThreadPublication        @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String                   @map("user_id")
  value         PublicationReactionValue
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@unique([publicationId, userId])
  @@index([publicationId, value])
  @@map("thread_publication_reactions")
}

model ThreadPublicationChangeRequest {
  id                 String                         @id @default(cuid())
  publicationId      String                         @map("publication_id")
  publication        ThreadPublication              @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  requesterId        String?                        @map("requester_id")
  suggestion         String                         @db.VarChar(5000)
  status             PublicationChangeRequestStatus @default(PENDING)
  ownerResponse      String?                        @map("owner_response") @db.VarChar(2000)
  acceptedRevisionId String?                        @map("accepted_revision_id")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  @@index([publicationId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([publicationId, requesterId, status])
  @@map("thread_publication_change_requests")
}

model ThreadPublicationReport {
  id            String                    @id @default(cuid())
  publicationId String                    @map("publication_id")
  publication   ThreadPublication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  commentId     String?                   @map("comment_id")
  comment       ThreadPublicationComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId    String?                   @map("reporter_id")
  reason        PublicationReportReason
  details       String?                   @db.VarChar(1000)
  status        PublicationReportStatus   @default(OPEN)
  moderatedBy   String?                   @map("moderated_by")
  moderatedAt   DateTime?                 @map("moderated_at")
  createdAt     DateTime                  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([publicationId, createdAt])
  @@map("thread_publication_reports")
}

/// Read model for the Board (search + listing). Rows exist only for publications that pass the public
/// visibility predicate; owned and kept in step by BoardIndexService. The tsvector column and the GIN
/// indexes (tsv, title_norm trigram) and the text_pattern_ops prefix index live in migrations only, Prisma
/// cannot express them. `trendingScore` is recomputed by BoardMaintenanceService, never by a request.
model ThreadPublicationSearchDoc {
  publicationId   String                   @id @map("publication_id")
  publication     ThreadPublication        @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  slug            String
  contentLocale   String                   @map("content_locale")
  publicationType String                   @map("publication_type")
  title           String
  excerpt         String
  titleNorm       String                   @map("title_norm")
  bodyNorm        String                   @map("body_norm")
  readingMinutes  Int                      @default(1) @map("reading_minutes")
  sourceCount     Int                      @default(0) @map("source_count")
  likeCount       Int                      @default(0) @map("like_count")
  dislikeCount    Int                      @default(0) @map("dislike_count")
  commentCount    Int                      @default(0) @map("comment_count")
  viewCount       Int                      @default(0) @map("view_count")
  publishedAt     DateTime                 @map("published_at") @db.Timestamptz(6)
  tsv             Unsupported("tsvector")?
  trendingScore   Float                    @default(0) @map("trending_score")
  docVersion      Int                      @default(0) @map("doc_version")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([contentLocale, publishedAt(sort: Desc), slug(sort: Desc)], map: "board_docs_locale_published_idx")
  @@index([publicationType, publishedAt(sort: Desc)], map: "board_docs_type_published_idx")
  @@index([publishedAt(sort: Desc), slug(sort: Desc)], map: "board_docs_published_idx")
  @@index([commentCount(sort: Desc), publishedAt(sort: Desc), slug(sort: Desc)], map: "board_docs_discussed_idx")
  @@index([likeCount(sort: Desc), publishedAt(sort: Desc), slug(sort: Desc)], map: "board_docs_liked_idx")
  @@index([trendingScore(sort: Desc), publishedAt(sort: Desc), slug(sort: Desc)], map: "board_docs_trending_idx")
  @@map("thread_publication_search_docs")
}

/// Distinct title words per locale behind the Board's "did you mean". Rebuilt by BoardMaintenanceService;
/// the trigram GIN index on `word` lives in the migration only (Prisma cannot express it).
model ThreadBoardWord {
  lang String
  word String
  freq Int    @default(1)

  @@id([lang, word])
  @@map("thread_board_words")
}

/// One owner-asked "Improve formatting with AI" pass over a Thread's article (ADR-189). The row is
/// the per-Thread daily limit, the idempotency record and the stored preview, so a replayed key
/// returns the same text without a second model call.
model ThreadFormatPass {
  id             String            @id @default(cuid())
  publicationId  String            @map("publication_id")
  publication    ThreadPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  ownerId        String            @map("owner_id")
  revisionId     String            @map("revision_id")
  idempotencyKey String            @map("idempotency_key")
  /// PENDING while the model runs, then FORMATTED, SKIPPED (kept as it was) or FAILED.
  status         String
  /// The SKIPPED/FAILED machine code (FORMAT_*), never model text.
  code           String?
  resultMarkdown String?           @map("result_markdown")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([ownerId, idempotencyKey])
  @@index([publicationId, createdAt])
  @@map("thread_format_passes")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  DRAFT
  READY_FOR_REVIEW
  PUBLISHED
  UNPUBLISHED
  REVOKED
}

enum RevisionReviewStatus {
  PENDING
  READY_FOR_REVIEW
  OWNER_APPROVED
  STALE
}

model ThreadPublication {
  id              String                      @id @default(cuid())
  ownerId         String?                     @map("owner_id")
  slug            String                      @unique
  status          PublicationStatus           @default(DRAFT)
  generationJobId String?                     @unique @map("generation_job_id")
  sourceSnapshot  Json?                       @map("source_snapshot")
  sourceHash      String?                     @map("source_hash")
  publishedAt     DateTime?                   @map("published_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  revisions       ThreadPublicationRevision[]

  @@index([ownerId, createdAt])
  @@index([status, publishedAt])
  @@map("thread_publications")
}

model ThreadPublicationRevision {
  id              String               @id @default(cuid())
  publicationId   String               @map("publication_id")
  publication     ThreadPublication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  revision        Int
  title           String
  content         Json
  contentHash     String               @map("content_hash")
  reviewStatus    RevisionReviewStatus @default(PENDING) @map("review_status")
  judgeScore      Int?                 @map("judge_score")
  criticScore     Int?                 @map("critic_score")
  validatedAt     DateTime?            @map("validated_at")
  ownerApprovedAt DateTime?            @map("owner_approved_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@unique([publicationId, revision])
  @@index([publicationId, reviewStatus])
  @@map("thread_publication_revisions")
}

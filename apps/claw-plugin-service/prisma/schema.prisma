generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CatalogSource {
  FIRST_PARTY
  CURATED_MCP
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  HIDDEN
}

enum RuntimeKind {
  BUILTIN
  MCP_REMOTE
}

enum AuthKind {
  NONE
  API_KEY
  BEARER_TOKEN
  OAUTH2_PKCE
}

enum InstallStatus {
  ENABLED
  DISABLED
}

enum InvocationStatus {
  OK
  ERROR
  TIMEOUT
  DENIED
  CONSENT_DECLINED
  CONSENT_TIMEOUT
  RATE_LIMITED
  QUOTA_EXCEEDED
  BLOCKED
}

enum RiskLevel {
  READ
  WRITE
  DESTRUCTIVE
}

enum ServerStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISABLED
  NEEDS_REVIEW
  UNREACHABLE
}

model PluginCatalogEntry {
  id               String        @id @default(uuid())
  slug             String        @unique
  source           CatalogSource
  status           CatalogStatus @default(DRAFT)
  category         String
  publisher        String
  iconKey          String        @map("icon_key")
  homepageUrl      String?       @map("homepage_url")
  translations     Json
  globallyEnabled  Boolean       @default(true) @map("globally_enabled")
  featured         Boolean       @default(false)
  currentVersionId String?       @unique @map("current_version_id")
  installCount     Int           @default(0) @map("install_count")
  /// Admin curation (plugins-admin-catalog): soft delete, notes, per-plan gate and health of a curated server.
  deletedAt        DateTime?     @map("deleted_at")
  adminNotes       String?       @map("admin_notes")
  needsVerification Boolean      @default(false) @map("needs_verification")
  /// Empty = every plan. Otherwise only these plan slugs may install the entry.
  allowedPlanSlugs String[]      @default([]) @map("allowed_plan_slugs")
  healthStatus     CatalogHealthStatus @default(UNKNOWN) @map("health_status")
  healthLatencyMs  Int?          @map("health_latency_ms")
  healthCheckedAt  DateTime?     @map("health_checked_at")
  healthErrorCode  String?       @map("health_error_code")
  versions         PluginVersion[]
  installs         PluginInstall[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([status, category])
  @@map("plugin_catalog_entries")
}

model PluginVersion {
  id           String             @id @default(uuid())
  entryId      String             @map("entry_id")
  entry        PluginCatalogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version      String
  runtimeKind  RuntimeKind        @map("runtime_kind")
  manifest     Json
  manifestHash String             @map("manifest_hash")
  signature    String?
  changelog    String?
  tools        PluginTool[]
  installs     PluginInstall[]
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([entryId, version])
  @@map("plugin_versions")
}

model PluginTool {
  id              String        @id @default(uuid())
  versionId       String        @map("version_id")
  version         PluginVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name            String
  riskLevel       RiskLevel     @map("risk_level")
  scopes          String[]
  disabledByAdmin Boolean       @default(false) @map("disabled_by_admin")

  @@unique([versionId, name])
  @@map("plugin_tools")
}

model PluginSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plugin_settings")
}

/// One user's installation of one catalog plugin, pinned to a version. Owner-scoped by userId.
model PluginInstall {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  pluginId    String              @map("plugin_id")
  plugin      PluginCatalogEntry  @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  versionId   String              @map("version_id")
  version     PluginVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  status      InstallStatus       @default(ENABLED)
  settings    Json                @default("{}")
  consents    PluginToolConsent[]
  credential  PluginCredential?
  installedAt DateTime            @default(now()) @map("installed_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([userId, pluginId])
  @@index([userId, status])
  @@index([pluginId])
  @@map("plugin_installs")
}

/// A stored grant for one tool. READ tools need none; DESTRUCTIVE is stored but the runtime asks every time.
model PluginToolConsent {
  id        String        @id @default(uuid())
  installId String        @map("install_id")
  install   PluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  toolName  String        @map("tool_name")
  level     RiskLevel
  grantedAt DateTime      @default(now()) @map("granted_at")
  /// True only when the user passed the second confirmation for a DESTRUCTIVE tool (in-chat consent card).
  confirmedDestructive Boolean @default(false) @map("confirmed_destructive")

  @@unique([installId, toolName])
  @@map("plugin_tool_consents")
}

/// Write-only secret. ciphertext is base64(nonce, tag, sealed bytes); AAD is userId:installId.
/// Never returned by any endpoint and never logged.
model PluginCredential {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  installId  String        @unique @map("install_id")
  install    PluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  kind       AuthKind
  headerName String?       @map("header_name")
  ciphertext String
  keyVersion Int           @default(1) @map("key_version")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("plugin_credentials")
}


/// Audit of tool calls. No secrets, no results. A call targets a catalog install or a user-registered
/// server, so both ids are optional and exactly one is set. (userId, callId) is the idempotency key of a call.
model PluginInvocation {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  installId       String?          @map("install_id")
  pluginId        String?          @map("plugin_id")
  serverId        String?          @map("server_id")
  callId          String?          @map("call_id")
  toolName        String           @map("tool_name")
  conversationId  String?          @map("conversation_id")
  messageId       String?          @map("message_id")
  surface         String
  status          InvocationStatus
  riskLevel       RiskLevel        @map("risk_level")
  consentDecision String?          @map("consent_decision")
  taintedTurn     Boolean          @default(false) @map("tainted_turn")
  argsHash        String           @map("args_hash")
  argsPreview     String?          @map("args_preview")
  resultBytes     Int?             @map("result_bytes")
  truncated       Boolean          @default(false)
  errorCode       String?          @map("error_code")
  durationMs      Int?             @map("duration_ms")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([userId, callId])
  @@index([userId, createdAt])
  @@index([pluginId, createdAt])
  @@index([installId])
  @@index([serverId])
  @@map("plugin_invocations")
}

/// A remote MCP server a user registered for their own account. Owner-scoped by ownerUserId. The URL is
/// https only and re-checked (DNS included) at registration, at every refresh and at every call.
model McpServer {
  id              String               @id @default(uuid())
  ownerUserId     String               @map("owner_user_id")
  /// "mcp" + 8 hex characters of the id; the slug in the native tool name plugin_slug_tool.
  slug            String               @unique
  name            String
  url             String
  urlHost         String               @map("url_host")
  authKind        AuthKind             @map("auth_kind")
  status          ServerStatus
  serverInfo      Json?                @map("server_info")
  /// Hash of the approved tool list. A different hash from tools/list sets NEEDS_REVIEW (tool poisoning).
  toolsHash       String?              @map("tools_hash")
  lastCheckedAt   DateTime?            @map("last_checked_at")
  lastErrorCode   String?              @map("last_error_code")
  failureCount    Int                  @default(0) @map("failure_count")
  breakerOpenedAt DateTime?            @map("breaker_opened_at")
  /// Admin decision on a pending server (plugins-admin-catalog).
  decidedBy       String?              @map("decided_by")
  decidedAt       DateTime?            @map("decided_at")
  decisionReason  String?              @map("decision_reason")
  tools           McpServerTool[]
  credential      McpServerCredential?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([ownerUserId, url])
  @@index([ownerUserId, status])
  @@index([urlHost])
  @@index([status, createdAt])
  @@map("mcp_servers")
}

/// The tools/list snapshot the user approved. Server-supplied text is untrusted and already sanitised.
/// Every tool starts as WRITE; only the owner may lower it.
model McpServerTool {
  id             String    @id @default(uuid())
  serverId       String    @map("server_id")
  server         McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The name as the server knows it.
  name           String
  /// The name used in the native tool name: [a-z0-9_]{1,40}.
  localName      String    @map("local_name")
  description    String
  inputSchema    Json      @map("input_schema")
  schemaHash     String    @map("schema_hash")
  riskLevel      RiskLevel @default(WRITE) @map("risk_level")
  enabled        Boolean   @default(true)
  consentGranted Boolean   @default(false) @map("consent_granted")

  @@unique([serverId, name])
  @@unique([serverId, localName])
  @@map("mcp_server_tools")
}

/// Write-only secret for a user server. Same sealing as PluginCredential; AAD is userId:serverId.
model McpServerCredential {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  serverId   String    @unique @map("server_id")
  server     McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind       AuthKind
  headerName String    @map("header_name")
  ciphertext String
  keyVersion Int       @default(1) @map("key_version")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("mcp_server_credentials")
}

enum ConsentRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED
}

enum ConsentChoice {
  ALLOW_ONCE
  ALLOW_CHAT
  ALWAYS_ALLOW
  DENY
}

/// One in-chat question "may this tool run with these arguments?". Bound to the user, the call id and the
/// argument hash; decided once; consumed once by the resumed call. The preview is redacted and truncated.
model PluginConsentRequest {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  installId      String?              @map("install_id")
  serverId       String?              @map("server_id")
  pluginSlug     String               @map("plugin_slug")
  pluginName     String               @map("plugin_name")
  toolName       String               @map("tool_name")
  toolTitle      String               @map("tool_title")
  riskLevel      RiskLevel            @map("risk_level")
  callId         String               @map("call_id")
  conversationId String?              @map("conversation_id")
  messageId      String?              @map("message_id")
  surface        String
  argsHash       String               @map("args_hash")
  argsPreview    String               @map("args_preview")
  reason         String
  status         ConsentRequestStatus @default(PENDING)
  choice         ConsentChoice?
  createdAt      DateTime             @default(now()) @map("created_at")
  expiresAt      DateTime             @map("expires_at")
  decidedAt      DateTime?            @map("decided_at")
  consumedAt     DateTime?            @map("consumed_at")
  /// Set only while PENDING: a hash of (user, tool, target, argument hash, conversation). Unique, so one
  /// identical question is one open card however many call ids the model produced. Cleared on any answer.
  pendingKey     String?              @unique @map("pending_key")

  @@unique([userId, callId])
  @@index([userId, status, expiresAt])
  @@index([conversationId])
  @@map("plugin_consent_requests")
}

/// "Allow for this chat": a WRITE tool the user approved for one conversation, until it expires or is revoked.
model PluginChatConsent {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  conversationId String    @map("conversation_id")
  targetKey      String    @map("target_key")
  pluginSlug     String    @map("plugin_slug")
  toolName       String    @map("tool_name")
  riskLevel      RiskLevel @map("risk_level")
  grantedAt      DateTime  @default(now()) @map("granted_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([userId, conversationId, targetKey, toolName])
  @@index([userId, expiresAt])
  @@map("plugin_chat_consents")
}

// ---- plugins-admin-catalog: curation, host rules, audit -------------------------------------

enum CatalogHealthStatus {
  UNKNOWN
  OK
  DOWN
}

enum HostRuleKind {
  ALLOW
  DENY
}

enum HostRuleMatch {
  HOST
  PUBLISHER
  SLUG
}

/// Admin allow/deny rule. HOST matches a host or its subdomains (user servers and curated URLs),
/// PUBLISHER and SLUG match curated entries. Any ALLOW rule of a match type turns that type into an allow-list.
model PluginHostRule {
  id        String        @id @default(uuid())
  kind      HostRuleKind
  match     HostRuleMatch
  pattern   String
  note      String?
  createdBy String        @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([kind, match, pattern])
  @@map("plugin_host_rules")
}

/// Who changed what in the admin console. No secrets, no credentials.
model PluginAdminAudit {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  summary    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("plugin_admin_audit")
}

/// A reviewed-but-not-installed import: the exact in-memory bundle the user is looking at, held for 30 minutes.
model PluginImportDraft {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  sourceKind String   @map("source_kind")
  sourceRef  String   @map("source_ref")
  commitSha  String?  @map("commit_sha")
  checksum   String
  preview    Json
  files      Json
  totalBytes Int      @map("total_bytes")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("plugin_import_drafts")
}

/// One user's imported (third-party) plugin. Inert: its files are documents, nothing in it is ever executed.
model ImportedPlugin {
  id         String               @id @default(uuid())
  userId     String               @map("user_id")
  name       String
  nameKey    String               @map("name_key")
  version    String
  sourceKind String               @map("source_kind")
  sourceRef  String               @map("source_ref")
  commitSha  String?              @map("commit_sha")
  checksum   String
  preview    Json
  totalBytes Int                  @map("total_bytes")
  fileCount  Int                  @map("file_count")
  files      ImportedPluginFile[]
  createdAt  DateTime             @default(now()) @map("created_at")

  @@unique([userId, nameKey])
  @@index([userId, createdAt])
  @@map("imported_plugins")
}

model ImportedPluginFile {
  id        String         @id @default(uuid())
  pluginId  String         @map("plugin_id")
  plugin    ImportedPlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  path      String
  content   String
  bytes     Int

  @@unique([pluginId, path])
  @@map("imported_plugin_files")
}

/// What was imported or removed, by whom, from where. No file contents.
model PluginImportAudit {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  pluginName String   @map("plugin_name")
  sourceKind String   @map("source_kind")
  sourceRef  String   @map("source_ref")
  commitSha  String?  @map("commit_sha")
  checksum   String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("plugin_import_audit")
}

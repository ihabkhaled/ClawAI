generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum ConnectorProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  AWS_BEDROCK
  DEEPSEEK
  OLLAMA
  GROK
  LLAMACPP
  // OpenAI-compatible presets (ADR-117). Base URLs, links and model-list
  // shapes live in CONNECTOR_PRESETS (@claw/shared-utilities), not here.
  OPENROUTER
  GROQ
  CEREBRAS
  SAMBANOVA
  DEEPINFRA
  FIREWORKS
  TOGETHER
  MISTRAL
  MOONSHOT
  ZAI
  QWEN
  CLOUDFLARE
  VERCEL_AI_GATEWAY
  PERPLEXITY
  COHERE
  // Custom provider identity is resolved through its linked database definition.
  CUSTOM_OPENAI_COMPATIBLE
}

enum ProviderAdapterFamily {
  OPENAI_COMPATIBLE
  CODE_MANAGED
}

enum ConnectorStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum ConnectorAuthType {
  API_KEY
  OAUTH2
  NONE
}

enum ModelLifecycle {
  ACTIVE
  DEPRECATED
  SUNSET
  REMOVED
}

enum ModelSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ModelExposure {
  UNEXPOSED
  EXPOSED
}

enum ModelKind {
  CHAT
  EMBEDDING
  RERANKER
  TOOL
  AUDIO
}

// ─── Models ──────────────────────────────────────────────

model Connector {
  id              String            @id @default(cuid())
  name            String
  provider        ConnectorProvider
  providerDefinitionId String?           @map("provider_definition_id")
  status          ConnectorStatus   @default(UNKNOWN)
  authType        ConnectorAuthType @map("auth_type")
  encryptedConfig String?           @map("encrypted_config")
  isEnabled       Boolean           @default(true) @map("is_enabled")
  defaultModelId  String?           @map("default_model_id")
  baseUrl         String?           @map("base_url")
  region          String?
  // Anthropic identity-linked keys refuse every call unless the request names
  // the workspace it acts in. Kept out of `region` on purpose: that field means
  // an AWS region, and overloading it would make both unreadable.
  workspaceId     String?           @map("workspace_id")
  // Cloudflare Workers AI scopes every URL to an account: the preset's base and
  // models URLs carry `{ACCOUNT_ID}`, filled from this column. Its own column
  // for the same reason `workspaceId` has one — `region` means an AWS region.
  // Validated as 32 lowercase hex characters before it is written (ADR-117).
  accountId       String?           @map("account_id")
  // LLM-gateway headers (F092) — LiteLLM, Portkey, Helicone, Cloudflare AI
  // Gateway and similar proxies authenticate or route on headers of their own
  // (`x-portkey-api-key`, `Helicone-Auth`, `cf-aig-authorization`). JSON object,
  // AES-encrypted like `encryptedConfig` because the values are credentials.
  // Null means "no gateway headers", never an empty object.
  encryptedGatewayHeaders String?     @map("encrypted_gateway_headers")
  // Whether inference through this connector costs ClawAI real money and must
  // therefore debit the user's PAYG credit wallet.
  //
  // `false` is the SAFE default: an unknown or newly added provider is free
  // until an operator says otherwise. The opposite default would start silently
  // charging users the moment someone adds a connector nobody classified, which
  // is a billing incident rather than a bug.
  //
  // THIS COLUMN IS THE RUNTIME AUTHORITY, not `PAYG_DEFAULT_PROVIDERS` in
  // `@claw/shared-constants`. That list is only the one-time default the
  // migration backfills with. Compiling the decision into six `node_modules`
  // copies of a shared package would make the admin toggle unenforceable
  // without a six-container rebuild (ADR-082), so the reservation path reads
  // the rolled-up connector policy from this column instead.
  isPayAsYouGo    Boolean           @default(false) @map("is_pay_as_you_go")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  providerDefinition ConnectorProviderDefinition? @relation(fields: [providerDefinitionId], references: [id], onDelete: Restrict)
  models       ConnectorModel[]
  healthEvents ConnectorHealthEvent[]
  syncRuns     ModelSyncRun[]

  @@index([provider])
  @@index([status])
  @@index([isEnabled])
  @@index([providerDefinitionId])
  @@map("connectors")
}

model ConnectorProviderDefinition {
  id                       String                @id @default(cuid())
  key                      String                @unique
  displayName              String                @map("display_name")
  description              String?
  adapterFamily             ProviderAdapterFamily @map("adapter_family")
  defaultBaseUrl            String?               @map("default_base_url")
  modelsEndpoint            String?               @map("models_endpoint")
  modelsResponseFormat      String?               @map("models_response_format")
  healthCheckEndpoint       String?               @map("health_check_endpoint")
  authType                  ConnectorAuthType?    @map("auth_type")
  authHeaderName            String                @default("Authorization") @map("auth_header_name")
  authHeaderScheme          String                @default("Bearer") @map("auth_header_scheme")
  supportsNativeTools      Boolean               @default(false) @map("supports_native_tools")
  supportsVision            Boolean               @default(false) @map("supports_vision")
  registerUrl               String?               @map("register_url")
  apiKeyUrl                 String?               @map("api_key_url")
  pricingUrl                String?               @map("pricing_url")
  docsUrl                   String?               @map("docs_url")
  defaultIsPayAsYouGo       Boolean               @default(false) @map("default_is_pay_as_you_go")
  hasFreeTier               Boolean               @default(false) @map("has_free_tier")
  isActive                  Boolean               @default(true) @map("is_active")
  isBuiltIn                 Boolean               @default(false) @map("is_built_in")
  connectorProvider         ConnectorProvider?    @unique @map("connector_provider")
  everConnected             Boolean               @default(false) @map("ever_connected")
  capabilityDefaults        Json                  @default("{}") @map("capability_defaults")
  createdBy                 String?               @map("created_by")
  updatedBy                 String?               @map("updated_by")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  connectors Connector[]

  @@index([isActive, updatedAt])
  @@index([adapterFamily, isActive])
  @@map("connector_provider_definitions")
}

model ConnectorModel {
  id                       String            @id @default(cuid())
  connectorId              String            @map("connector_id")
  provider                 ConnectorProvider
  modelKey                 String            @map("model_key")
  displayName              String            @map("display_name")
  lifecycle                ModelLifecycle    @default(ACTIVE)
  supportsStreaming        Boolean           @default(false) @map("supports_streaming")
  supportsTools            Boolean           @default(false) @map("supports_tools")
  supportsVision           Boolean           @default(false) @map("supports_vision")
  supportsAudio            Boolean           @default(false) @map("supports_audio")
  supportsVideoInput       Boolean           @default(false) @map("supports_video_input")
  supportsStructuredOutput Boolean           @default(false) @map("supports_structured_output")
  maxContextTokens         Int?              @map("max_context_tokens")
  // Output ceiling the provider's catalog publishes (a sync overwrites it).
  maxOutputTokens          Int?              @map("max_output_tokens")
  // Output ceiling learned from a provider refusal: only ever lowered, never
  // touched by a sync (ADR-125). NULL = unknown, not unlimited.
  learnedMaxOutputTokens   Int?              @map("learned_max_output_tokens")
  learnedMaxOutputAt       DateTime?         @map("learned_max_output_at")
  usageTier                ModelUsageTier    @default(UNKNOWN) @map("usage_tier")
  inputUsdPerMillion       Decimal?          @map("input_usd_per_million") @db.Decimal(12, 6)
  cachedInputUsdPerMillion Decimal?          @map("cached_input_usd_per_million") @db.Decimal(12, 6)
  outputUsdPerMillion      Decimal?          @map("output_usd_per_million") @db.Decimal(12, 6)
  syncedAt                 DateTime          @default(now()) @map("synced_at")
  exposure                 ModelExposure     @default(UNEXPOSED)
  kind                     ModelKind         @default(CHAT)
  lastSeenAt               DateTime?         @map("last_seen_at")
  // Provider answers of "model does not exist" reported by chat-service inside
  // the retire window (ADR-151). A sync never resets it.
  unavailableCount         Int               @default(0) @map("unavailable_count")
  unavailableAt            DateTime?         @map("unavailable_at")
  // F093: ask the provider to cache this model's prompt (Anthropic Messages API
  // `cache_control`). DEFAULT OFF and never touched by a sync. Turning it on
  // changes what a request costs, because a cache WRITE is billed at the
  // model's `cacheWritePerMillionMicroUsd` rate in routing-service, so it is an
  // administrator decision per model, never inferred. Only ANTHROPIC rows can
  // carry it.
  promptCaching            Boolean           @default(false) @map("prompt_caching")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, modelKey])
  @@index([connectorId])
  @@index([provider])
  @@index([lifecycle])
  @@index([exposure])
  @@map("connector_models")
}

enum ModelUsageTier {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  EXTRA_HIGH
}

model ConnectorHealthEvent {
  id           String          @id @default(cuid())
  connectorId  String          @map("connector_id")
  status       ConnectorStatus
  latencyMs    Int?            @map("latency_ms")
  errorMessage String?         @map("error_message")
  checkedAt    DateTime        @default(now()) @map("checked_at")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([checkedAt])
  @@map("connector_health_events")
}

model ModelSyncRun {
  id            String          @id @default(cuid())
  connectorId   String          @map("connector_id")
  status        ModelSyncStatus
  modelsFound   Int             @default(0) @map("models_found")
  modelsAdded   Int             @default(0) @map("models_added")
  modelsRemoved Int             @default(0) @map("models_removed")
  startedAt     DateTime        @default(now()) @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  errorMessage  String?         @map("error_message")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([status])
  @@map("model_sync_runs")
}

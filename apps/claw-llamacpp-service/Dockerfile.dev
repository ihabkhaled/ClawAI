FROM node:26-bookworm-slim
# Debian base (not Alpine) — the TypeScript 7 npm compiler ships glibc-linked
# binaries with no musl variant. Alpine would fail to load the TypeScript 7 compiler.
RUN apt-get update && apt-get install -y --no-install-recommends openssl curl ca-certificates wget tar xz-utils unzip libgomp1 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy entire monorepo structure for workspace resolution
COPY package.json ./package.json
COPY tools/typescript/ ./tools/typescript/
COPY .npmrc ./.npmrc
COPY packages/ ./packages/
COPY apps/claw-llamacpp-service/ ./apps/claw-llamacpp-service/

# Install workspace deps FIRST so all @types/* are hoisted at root AND all
# @claw/* workspace packages get symlinked into /app/node_modules. Also pulls
# the TypeScript 7 npm compiler-linux-x64 (glibc binary) via the typescript alias.
WORKDIR /app
RUN npm install --ignore-scripts --legacy-peer-deps

# Compile shared packages with workspace-hoisted types available
RUN cd packages/shared-constants && npm run build
RUN cd packages/shared-types && npm run build
RUN cd packages/shared-utilities && npm run build
RUN cd packages/shared-rabbitmq && npm run build
RUN cd packages/shared-auth && npm run build
RUN cd packages/shared-entitlements && npm run build

WORKDIR /app/apps/claw-llamacpp-service
RUN npx prisma generate
RUN chmod +x docker-entrypoint.dev.sh

EXPOSE 4017
CMD ["./docker-entrypoint.dev.sh"]

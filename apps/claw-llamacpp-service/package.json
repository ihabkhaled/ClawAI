{
  "name": "claw-llamacpp-service",
  "version": "1.56.0",
  "private": true,
  "description": "Claw Llama.cpp Service - Local Frontier LLM runtime (llama-server proxy + lifecycle)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --delay 1500ms --signal SIGTERM --exec \"npm run build && node dist/main.js\"",
    "build": "node ../../tools/typescript/run-ts7.mjs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/ --concurrency=4",
    "lint:strict": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "node ../../tools/typescript/run-ts7.mjs --noEmit",
    "validate": "npm run typecheck && npm run lint:strict && npm run format:check",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "seed:catalog": "npx tsx --tsconfig prisma/tsconfig.seed.json prisma/seed-catalog.ts"
  },
  "dependencies": {
    "@claw/shared-constants": "*",
    "@claw/shared-entitlements": "*",
    "@claw/shared-rabbitmq": "*",
    "@claw/shared-types": "*",
    "@claw/shared-utilities": "*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "amqplib": "^2.0.1",
    "async-mutex": "^0.5.0",
    "axios": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "node-stream-zip": "^1.16.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.22",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "73.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}

        "REDIS_URL",
        "RABBITMQ_URL",
        "JWT_SECRET",
        "INTER_SERVICE_AUTH_TOKEN",
        "BLOB_READ_WRITE_TOKEN"
      ],
      "optionalEnvironmentVariables": [
        "AUTH_SERVICE_URL",
        "FILE_STORAGE_PATH",
        "CLAMAV_ENABLED",
        "CLAMAV_HOST",
        "CLAMAV_PORT",
        "FILE_RETENTION_DAYS",
        "FILE_RETENTION_SWEEP_CRON",
        "FILE_RETENTION_SWEEP_BATCH_LIMIT",
        "ZIP_MAX_EXTRACTED_SIZE_MB",
        "ZIP_MAX_ENTRY_COUNT",
        "ZIP_MAX_NESTING_DEPTH",
        "ZIP_COMPRESSION_RATIO_THRESHOLD",
        "ZIP_TEMP_EXTRACTION_PATH",
        "OCR_ENABLED",
        "OCR_TIMEOUT_MS",
        "OCR_CONFIDENCE_MIN",
        "OCR_LANGUAGE",
        "OCR_WORKER_THREADS",
        "SCANNED_PDF_CHAR_THRESHOLD",
        "CORS_ORIGINS",
        "CLAW_HOSTNAME",
        "NODE_ENV"
      ],
      "dependencies": [
        "auth"
      ],
      "publicRoutes": [
        "/api/v1/health"
      ],
      "routes": [
        "/api/v1/files/*"
      ],
      "runtimeCaveats": [
        "Vercel functions have an ephemeral, read-only filesystem apart from /tmp. FILE_STORAGE_PATH must point at /tmp and durable blobs must go to object storage (BLOB_READ_WRITE_TOKEN). Uploads written only to FILE_STORAGE_PATH will not survive an invocation.",
        "CLAMAV_ENABLED must be false unless an externally reachable ClamAV TCP endpoint is provided — there is no ClamAV sidecar on Vercel.",
        "OCR_ENABLED must be false — the tesseract worker pool needs a persistent process and native binaries not present in the Vercel runtime.",
        "FILE_RETENTION_SWEEP_CRON is an in-process @nestjs/schedule cron and will never fire on Vercel. KNOWN GAP: retention will simply not run. Driving it from a Vercel Cron entry requires an HTTP endpoint that triggers a sweep, which the service does not expose today."
      ]
    },

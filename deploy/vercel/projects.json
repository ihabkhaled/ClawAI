{
  "$schema": "./projects.schema.json",
  "version": 1,
  "description": "Single source of truth for every ClawAI Vercel project. Consumed by every script under scripts/vercel/. Never hardcode project names, paths, or build commands anywhere else.",
  "statusLegend": {
    "enabled": "Provisioned and deployed to Vercel by the automation.",
    "disabled": "Deployable in principle, but switched off for this deployment. Skipped with an explicit log line.",
    "external-only": "Replaced by a managed external service on Vercel. Never provisioned; its capability is supplied by an external URL/API key.",
    "not-vercel-compatible": "Cannot run on Vercel at all (local GPU/binary/filesystem runtime). Never provisioned. Documented in docs/deployment/vercel-automated-deployment.md."
  },
  "defaults": {
    "installCommand": "cd ../.. && npm ci",
    "productionBranch": "main",
    "nodeVersion": "22.x",
    "apiPrefix": "api/v1"
  },

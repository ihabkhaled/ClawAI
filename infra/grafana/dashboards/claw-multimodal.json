{
  "uid": "claw-multimodal",
  "title": "ClawAI — Multimodal",
  "description": "Media pipeline metrics (pack §67, ADR-113 addendum): transcription, video, attachment delivery, vision helper, read aloud and image generation. Labels are bounded enums only. Provisioned from infra/grafana/dashboards; edit the file, not the UI.",
  "tags": ["clawai", "multimodal"],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Transcription and video (file-service)",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "claw-prometheus"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transcription calls by outcome",
      "description": "Provider calls per second, by provider and outcome (success, empty, refused, rate_limited, failed, cancelled). A rising rate_limited or empty share is the first sign of a provider problem.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "claw-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "claw-prometheus"
          },
          "expr": "sum by (provider, outcome) (rate(claw_file_transcription_attempts_total[$__rate_interval]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transcription job duration (p50 / p95)",
      "description": "One job end to end, every call and retry included, by source (upload or a video's audio).",

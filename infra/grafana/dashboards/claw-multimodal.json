        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "claw-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(claw_file_transcription_job_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{source}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "claw-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(claw_file_transcription_job_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{source}}"

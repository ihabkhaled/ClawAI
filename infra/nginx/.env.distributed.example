# =============================================================================
# ClawAI — distributed nginx edge router configuration
#
#   cp infra/nginx/.env.distributed.example infra/nginx/.env.distributed
#
# Consumed by envsubst when the nginx container starts against
# infra/nginx/nginx.distributed.conf.template. The local Docker config
# (infra/nginx/nginx.conf) does not read this file.
#
# Origins are HOST[:PORT] with NO scheme and NO trailing slash — the template
# applies https:// itself:
#
#   right:  claw-auth-service.vercel.app
#   right:  auth.internal.example.com:4001
#   wrong:  https://claw-auth-service.vercel.app
#   wrong:  claw-auth-service.vercel.app/
#
# To fill these from a live Vercel deployment:
#   npm run vercel:resolve-urls -- --target production
#   # then strip the https:// prefix from
#   # deploy/vercel/generated/service-urls.production.env
# =============================================================================


# -----------------------------------------------------------------------------
# Edge
# -----------------------------------------------------------------------------
# Public hostname this nginx answers on. Must match the TLS certificate.
CLAW_PUBLIC_HOSTNAME=claw.example.com

# Edge TLS material (browser -> nginx). For a public deployment these are
# real certificates (Let's Encrypt), not the mkcert pair used locally.
CLAW_TLS_CERT_PATH=/etc/nginx/certs/claw.crt
CLAW_TLS_KEY_PATH=/etc/nginx/certs/claw.key

# DNS resolver nginx uses to re-resolve the origins at runtime. Public
# resolvers by default; inside a VPC use the VPC resolver instead
# (AWS: 169.254.169.253, GCP: 169.254.169.254).
CLAW_DNS_RESOLVER=1.1.1.1 8.8.8.8


# -----------------------------------------------------------------------------
# Service origins — one host per service
# -----------------------------------------------------------------------------
CLAW_FRONTEND_ORIGIN=claw-frontend-ten.vercel.app

CLAW_AUTH_ORIGIN=claw-auth-service.vercel.app
CLAW_PAYMENT_ORIGIN=claw-payment-service.vercel.app
CLAW_CHAT_ORIGIN=claw-chat-service.vercel.app
CLAW_CONNECTOR_ORIGIN=claw-connector-service.vercel.app
CLAW_ROUTING_ORIGIN=claw-routing-service.vercel.app
CLAW_MEMORY_ORIGIN=claw-memory-service.vercel.app
CLAW_FILE_ORIGIN=claw-file-service.vercel.app
CLAW_AUDIT_ORIGIN=claw-audit-service.vercel.app
CLAW_HEALTH_ORIGIN=claw-health-service.vercel.app
CLAW_CLIENT_LOGS_ORIGIN=claw-client-logs-service.vercel.app
CLAW_SERVER_LOGS_ORIGIN=claw-server-logs-service.vercel.app
CLAW_IMAGE_ORIGIN=claw-image-service.vercel.app
CLAW_FILE_GENERATION_ORIGIN=claw-file-generation-service.vercel.app
CLAW_WORKSPACE_ORIGIN=claw-workspace-service.vercel.app
CLAW_AGENT_ORIGIN=claw-agent-service.vercel.app
CLAW_RESEARCH_ORIGIN=claw-research-service.vercel.app


# -----------------------------------------------------------------------------
# Local-runtime services — leave EMPTY unless you host them yourself
# -----------------------------------------------------------------------------
# claw-ollama-service and claw-llamacpp-service need a GPU, a persistent volume
# and local binaries, so they have no managed origin. Left empty, their routes
# answer 503 with an explanatory body instead of a bare 502.
#
# Set them only if you run these services on your own hardware and have exposed
# them over HTTPS with a publicly trusted certificate.
CLAW_OLLAMA_ORIGIN=
CLAW_LLAMACPP_ORIGIN=

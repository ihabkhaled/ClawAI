##############################################################################
# ClawAI — distributed nginx edge router
#
# A sibling of infra/nginx/nginx.conf, NOT a replacement. Use this one when the
# microservices no longer share a Docker network and each lives on its own host
# (Vercel, Render, Fly, separate VMs). The local config stays as it is.
#
#   nginx.conf                     services co-located, Docker DNS, mkcert CA
#   nginx.distributed.conf.template  one origin per service, public DNS, public CA
#
# ---------------------------------------------------------------------------
# What changed vs the local config, and why
# ---------------------------------------------------------------------------
# 1. resolver        127.0.0.11 (Docker DNS) -> public DNS. Managed platforms
#                    rotate IPs, so every origin is re-resolved at runtime.
# 2. proxy_pass      Kept as `set $var; proxy_pass $var;` — deliberately NOT
#                    upstream{} blocks. nginx resolves upstream server names
#                    once at startup; a Vercel/Render IP change would then be
#                    invisible until reload. The variable form re-resolves via
#                    the resolver directive above.
# 3. Host header     $host -> $proxy_host. THE critical change. Managed
#                    platforms route by Host/SNI, so forwarding the browser's
#                    Host ("claw.example.com") reaches the platform edge and
#                    404s. Backends still see the original via X-Forwarded-Host.
# 4. Upstream TLS    mkcert rootCA -> system CA bundle, plus proxy_ssl_name for
#                    correct SNI on shared-IP platforms.
# 5. Origins         Hardcoded service:port -> ${CLAW_*_ORIGIN} env variables,
#                    substituted at container start.
# 6. Client address  Services believe X-Real-IP only from a TRUSTED proxy
#                    (rules/58 item 3). Locally that is the docker name
#                    "nginx"; here nginx reaches each service from its public
#                    egress IP, which that lookup cannot find. Set
#                    TRUSTED_PROXY_ADDRESSES on EVERY service to this edge's
#                    egress IPs/CIDRs. Left blank, every visitor shares one
#                    rate-limit bucket keyed on this edge, and a handful of
#                    failed logins locks the whole site out of sign-in.
# 7. Edge policy     The verified-crawler verdict, the smart rate limits, the scanner 404s
#                    and the AEAD-only TLS 1.2 suites (ADR-232) are the same block as in
#                    nginx.conf (BEGIN claw-edge-policy), kept identical by a test.
#
# Everything else — every route, rewrite, timeout and SSE setting — is carried
# over unchanged, because that behaviour is transport-independent.
#
# ---------------------------------------------------------------------------
# How to run it
# ---------------------------------------------------------------------------
#   docker run --rm \
#     --env-file infra/nginx/.env.distributed \
#     -e NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx \
#     -v $PWD/infra/nginx/nginx.distributed.conf.template:/etc/nginx/templates/nginx.conf.template:ro \
#     -v $PWD/certs:/etc/nginx/certs:ro \
#     -v $PWD/infra/nginx/verified-crawlers:/etc/nginx/claw/verified-crawlers:ro \
#     -p 443:443 -p 80:80 nginx:1.27-alpine
#
# The official image runs envsubst over /etc/nginx/templates/*.template at
# start-up. NGINX_ENVSUBST_OUTPUT_DIR makes it write /etc/nginx/nginx.conf.
#
# The verified-crawlers mount is a DIRECTORY on purpose (ADR-232): it holds ranges.conf, the generated
# Google / Bing / Apple / ... IP ranges the edge policy block reads, and a directory mount follows a
# refreshed file where a single-file bind mount keeps serving the old inode. nginx refuses to start
# without it.
#
# Origin variables take a HOST[:PORT] with NO scheme — https is applied here:
#   CLAW_AUTH_ORIGIN=claw-auth-service.vercel.app
#   CLAW_AUTH_ORIGIN=auth.internal.example.com:4001
#
# See infra/nginx/.env.distributed.example for the full list.
##############################################################################

worker_processes auto;

events {
    worker_connections 4096;
}

http {
    # --- DNS resolver -------------------------------------------------------
    # Public resolver, not Docker's 127.0.0.11. `valid=` caps how long a record
    # is cached: managed platforms move IPs, and a stale record is a hard-down
    # origin. Override with CLAW_DNS_RESOLVER (e.g. a VPC resolver).
    resolver ${CLAW_DNS_RESOLVER} valid=30s ipv6=off;
    resolver_timeout 5s;

    # --- Timeouts -----------------------------------------------------------
    # Higher than the local config: this hop now crosses the public internet,
    # and a cold serverless origin can take seconds to answer its first request.
    proxy_connect_timeout 15s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    # --- Request body -------------------------------------------------------
    client_max_body_size 75m;

    # Anonymous feedback form budget (ADR-141).
    limit_req_zone $binary_remote_addr zone=public_feedback:10m rate=20r/m;

    # Sign-in / sign-up flood brake, POSTs only (rules/58, ADR-147).
    map $request_method $auth_post_key {
        default "";
        POST    $binary_remote_addr;
    }
    limit_req_zone $auth_post_key zone=auth_routes:10m rate=60r/m;
    # Same edge budgets as nginx.conf (security incident 2026-11-27, rules/58, rules/68).
    limit_req_zone $auth_post_key zone=auth_signup:10m rate=2r/m;
    limit_req_zone $auth_post_key zone=auth_login:10m rate=12r/m;
    limit_req_zone $auth_post_key zone=auth_bot_check:10m rate=20r/m;
    limit_req_zone $auth_post_key zone=client_logs:10m rate=60r/m;
    # Per-address brake for the whole /api/v1/agent surface (owner decision 2026-11-28, ADR-230).
    # Generous on purpose: signed-in extensions poll; it only stops a flood from one address.
    limit_req_zone $binary_remote_addr zone=agent_api:10m rate=300r/m;
    limit_conn_zone $binary_remote_addr zone=per_ip_conn:10m;
    limit_conn_status 429;
    limit_conn per_ip_conn 100;
    limit_req_status 429;

    # BEGIN claw-edge-policy
    # ==========================================================================
    # Edge policy (ADR-232): slow clients, who a crawler really is, smart rate limits and scanner
    # probes. THIS BLOCK IS IDENTICAL in nginx.conf and nginx.distributed.conf.template;
    # tools/__tests__/nginx-edge-policy.test.mjs fails when the two drift. Tune the numbers here.
    # ==========================================================================

    # --- Slow clients and connection hygiene ---------------------------------
    # A client that trickles its headers or body holds a connection for nothing (slowloris). These are
    # generous for a real browser on a bad mobile network. client_max_body_size is deliberately NOT
    # here: chat, Threads and uploads accept multi-MB bodies, and each route keeps its own cap.
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 30s;
    reset_timedout_connection on;
    client_header_buffer_size 4k;
    large_client_header_buffers 4 16k;
    # A 429 is the limiter doing its job, not an error: keep the error log for real errors.
    limit_req_log_level warn;
    limit_conn_log_level warn;

    # --- Access log: "combined" plus the crawler verdict --------------------
    # The leading fields are exactly nginx's "combined" format, so every fail2ban filter written for it
    # keeps matching (the client address stays first, the request and the status stay in place). The
    # two trailing fields are the verdict: crawler=<who the User-Agent CLAIMS, or empty> and
    # verdict=<none|verified|fake|unchecked>. fail2ban anchors on them at the END of the line.
    log_format claw_edge '$remote_addr - $remote_user [$time_local] "$request" '
                         '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                         'crawler=$claw_crawler_claimed verdict=$claw_crawler_verdict';
    access_log /var/log/nginx/access.log claw_edge;

    # --- 1. Which crawler does the request CLAIM to be? ----------------------
    # Only crawlers whose operator publishes an IP range file (tools/crawlers/crawler-sources.mjs).
    # Yandex, Baidu, PetalBot, Seznam and every other reverse-DNS-only or unpublished crawler is NOT
    # listed on purpose: a request that claims to be one is an ordinary visitor, never refused for the
    # claim. The value is the operator name used in ranges.conf. A name must be preceded by the start of
    # the User-Agent or a non-alphanumeric, so "ccbot" cannot match inside an unrelated word.
    map $http_user_agent $claw_crawler_claimed {
        default "";
        "~*(?:^|[^a-z0-9])(?:googlebot|adsbot-google|mediapartners-google|apis-google|googleother|google-inspectiontool|storebot-google|google-cloudvertexbot|feedfetcher-google|google-read-aloud|google-site-verification)" google;
        "~*(?:^|[^a-z0-9])bingbot" bing;
        "~*(?:^|[^a-z0-9])applebot" apple;
        "~*(?:^|[^a-z0-9])(?:duckduckbot|duckassistbot)" duckduckgo;
        "~*(?:^|[^a-z0-9])(?:gptbot|oai-searchbot|chatgpt-user)" openai;
        "~*(?:^|[^a-z0-9])(?:perplexitybot|perplexity-user)" perplexity;
        "~*(?:^|[^a-z0-9])mistralai-user" mistral;
        "~*(?:^|[^a-z0-9])ccbot" commoncrawl;
        "~*(?:^|[^a-z0-9])(?:ahrefsbot|ahrefssiteaudit)" ahrefs;
    }

    # --- 2. Does the ADDRESS prove it? ---------------------------------------
    # ranges.conf is generated from the operators' own published files (never edit it by hand). It is in
    # a DIRECTORY mount so a host refresh is seen by a reload (a single-file bind mount is not).
    geo $remote_addr $claw_crawler_ip_owner {
        default "";
        include /etc/nginx/claw/verified-crawlers/ranges.conf;
    }

    # Addresses nginx cannot tell clients apart by: loopback, private, link-local, CGNAT, unique-local.
    # Behind Docker an IPv6 visitor reaches nginx as the bridge gateway (172.x), for example. Such a
    # source is never judged a fake crawler and never counted per address.
    map $remote_addr $claw_addr_private {
        default 0;
        "~^(?:127\.|10\.|192\.168\.|169\.254\.|172\.(?:1[6-9]|2[0-9]|3[01])\.|100\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)" 1;
        "~*^(?:::1$|f[cd][0-9a-f]{2}:|fe80:)" 1;
    }

    # --- 3. The verdict -------------------------------------------------------
    #   none       claims no listed crawler: every human and every unlisted bot
    #   verified   claims a crawler AND the address is in THAT operator's published ranges
    #   fake       claims a listed crawler from an address outside its ranges  -> 403, fail2ban 24 h
    #   unchecked  claims a listed crawler but the source address is private/docker: cannot be judged,
    #              treated as an ordinary visitor
    # The key is "<claimed>|<owner of the address>|<private 0/1>"; the first matching line wins.
    map "$claw_crawler_claimed|$claw_crawler_ip_owner|$claw_addr_private" $claw_crawler_verdict {
        default                          fake;
        "~^\|"                           none;
        "~^[a-z0-9]+\|[a-z0-9]*\|1$"     unchecked;
        "~^([a-z0-9]+)\|\1\|0$"          verified;
    }

    # --- Smart rate limits -----------------------------------------------------
    # One address, three budgets; each request is counted in exactly one of them.
    #   claw_general  every dynamic request (pages, /api/v1/*): 30 req/s sustained, burst 400. A page load
    #                 plus its API calls is a few dozen requests, a polling client a few per second.
    #   claw_static   immutable assets (/_next/static, images, fonts): 100 req/s, burst 1000. Separate so
    #                 a page full of assets never spends the dynamic budget, but not unmetered (a missing
    #                 asset is an expensive Next 404).
    #   claw_crawler  a VERIFIED crawler, all requests: 15 req/s, burst 150. Generous, not unlimited; an
    #                 abusive crawler gets 429 and a one hour ban, never days (SEO).
    # A private or docker source address has an empty key and is not counted (see above). The existing
    # per-route zones (auth, payments, feedback, agent, client logs) stay as they are.
    map $claw_addr_private $claw_addr_key {
        default $binary_remote_addr;
        1       "";
    }

    map $uri $claw_static_asset {
        default 0;
        "~^/_next/static/" 1;
        "~^/(?:marketing|workers|worklets|fonts)/" 1;
        "~*^/[^/]+\.(?:png|jpe?g|webp|avif|svg|ico|woff2?|css|js)$" 1;
    }

    map "$claw_static_asset|$claw_crawler_verdict" $claw_general_key {
        default          $claw_addr_key;
        "~\|verified$"   "";
        "~^1\|"          "";
    }

    map "$claw_static_asset|$claw_crawler_verdict" $claw_static_key {
        default          "";
        "~\|verified$"   "";
        "~^1\|"          $claw_addr_key;
    }

    map $claw_crawler_verdict $claw_crawler_key {
        default  "";
        verified $binary_remote_addr;
    }

    limit_req_zone $claw_general_key zone=claw_general:20m rate=30r/s;
    limit_req_zone $claw_static_key  zone=claw_static:10m  rate=100r/s;
    limit_req_zone $claw_crawler_key zone=claw_crawler:10m rate=15r/s;

    # Every nginx-made 429 (a limit_req zone, the connection cap) answers the same way: JSON, no-store
    # and a Retry-After. A crawler is told to wait longer than a person.
    map $claw_crawler_verdict $claw_retry_after {
        default  10;
        verified 120;
    }

    # --- Scanner probes ---------------------------------------------------------
    # A cheap request must not buy an expensive answer: an unknown path used to be proxied to Next.js,
    # which rendered a ~470 KB 404 page for /.env. These patterns get a tiny 404 from nginx itself, are
    # still logged (fail2ban's claw-nginx-scan jail reads them) and never reach a service. The site
    # serves no PHP, no dotfile (except /.well-known/), no config, backup or lock file.
    map $request_uri $claw_scanner_probe {
        default 0;
        # Path traversal, raw or percent-encoded, in the path or the query.
        "~*(?:\.\.|%2e%2e|%252e)(?:/|%2f|%5c|%252f)" 1;
        # Dot files and dot directories (.env, .git, .aws, .ssh, .htaccess, .DS_Store), not /.well-known/.
        "~*^[^?]*/(?:\.|%2e)(?!well-known(?:/|\?|$))" 1;
        # Server-side scripts the site does not run, and the CMS / admin / framework probes.
        "~*^[^?]*(?:\.(?:php[0-9]?|phtml|asp|aspx|jsp|jspx|cgi)(?:/|\?|$)|/(?:wp-admin|wp-login|wp-content|wp-includes|wp-json|xmlrpc|phpmyadmin|actuator|cgi-bin|server-status|server-info|vendor/phpunit|@id/__vite|@fs/|boaform|HNAP1)|/pma(?:/|\?|$))" 1;
        # Backup, dump, key and config files at the site root (under /api/ and /_next/ a file name is data).
        "~*^/(?!api/|_next/)[^?]*\.(?:sql|sqlite3?|db|bak|backup|old|orig|swp|save|log|ini|conf|cfg|toml|ya?ml|pem|key|p12|pfx|tar|tgz|zip|rar|7z|tar\.gz|sql\.gz)(?:\?|$)" 1;
        # Well-known file names that expose source, dependencies or API surface.
        "~*^/(?!api/|_next/)(?:[^?]*/)?(?:docker-compose[^/?]*|dockerfile|package(?:-lock)?\.json|composer\.(?:json|lock)|yarn\.lock|pnpm-lock\.yaml|tsconfig[^/?]*\.json|appsettings[^/?]*\.json|config\.json|credentials\.json|secrets?\.json|serviceaccount[^/?]*\.json|firebase\.json|web\.config|crossdomain\.xml|swagger[^/?]*\.(?:json|ya?ml)|swagger-ui[^?]*|swagger-resources|openapi\.(?:json|ya?ml)|v2/api-docs|phpinfo[^/?]*)(?:\?|$|/)" 1;
    }
    # END claw-edge-policy

    # --- Security headers ---------------------------------------------------
    # Services set nosniff themselves for direct access (helmet, download
    # controllers). Drop theirs here so exactly one reaches the client. The same
    # goes for X-Frame-Options and Referrer-Policy, which Next.js also sets
    # (next.config.mjs) for direct access: nginx is the single source of truth.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

    server_tokens off;

    # --- Edge TLS (browser -> nginx) ---------------------------------------
    ssl_protocols       TLSv1.2 TLSv1.3;
    # TLS 1.2 is limited to forward-secret AEAD suites (ECDHE with AES-GCM or ChaCha20-Poly1305): no CBC,
    # no RSA key exchange, no static DH. TLS 1.3 suites are AEAD by design and are not set by this line.
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # --- Upstream TLS (nginx -> service) -----------------------------------
    # Public CA bundle, not the mkcert root: these origins present certificates
    # from real authorities. proxy_ssl_name/server_name send the correct SNI,
    # without which a shared-IP platform cannot pick the right certificate and
    # the handshake fails.
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify              on;
    proxy_ssl_verify_depth        3;
    proxy_ssl_server_name         on;
    proxy_ssl_name                $proxy_host;
    proxy_ssl_protocols           TLSv1.2 TLSv1.3;

    # --- WebSocket upgrade --------------------------------------------------
    # Sends `Connection: upgrade` only for real upgrade requests and
    # `Connection: ""` otherwise, which is what keeps SSE responses unbuffered
    # on a keepalive connection.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # --- Service origins ----------------------------------------------------
    # Substituted by envsubst at container start. Declared once here as maps so
    # a typo is a start-up failure rather than a 502 discovered in production.
    map $host $origin_auth            { default "${CLAW_AUTH_ORIGIN}"; }
    map $host $origin_payment         { default "${CLAW_PAYMENT_ORIGIN}"; }
    map $host $origin_threads         { default "${CLAW_THREADS_ORIGIN}"; }
    map $host $origin_plugin          { default "${CLAW_PLUGIN_ORIGIN}"; }
    map $host $origin_live            { default "${CLAW_LIVE_ORIGIN}"; }
    map $host $origin_chat            { default "${CLAW_CHAT_ORIGIN}"; }
    map $host $origin_connector       { default "${CLAW_CONNECTOR_ORIGIN}"; }
    map $host $origin_routing         { default "${CLAW_ROUTING_ORIGIN}"; }
    map $host $origin_memory          { default "${CLAW_MEMORY_ORIGIN}"; }
    map $host $origin_file            { default "${CLAW_FILE_ORIGIN}"; }
    map $host $origin_audit           { default "${CLAW_AUDIT_ORIGIN}"; }
    map $host $origin_health          { default "${CLAW_HEALTH_ORIGIN}"; }
    map $host $origin_client_logs     { default "${CLAW_CLIENT_LOGS_ORIGIN}"; }
    map $host $origin_server_logs     { default "${CLAW_SERVER_LOGS_ORIGIN}"; }
    map $host $origin_image           { default "${CLAW_IMAGE_ORIGIN}"; }
    map $host $origin_file_generation { default "${CLAW_FILE_GENERATION_ORIGIN}"; }
    map $host $origin_workspace       { default "${CLAW_WORKSPACE_ORIGIN}"; }
    map $host $origin_agent           { default "${CLAW_AGENT_ORIGIN}"; }
    map $host $origin_research        { default "${CLAW_RESEARCH_ORIGIN}"; }
    map $host $origin_frontend        { default "${CLAW_FRONTEND_ORIGIN}"; }

    # Local-runtime services. These have no remote origin in a distributed
    # deployment (they need a GPU, a persistent volume and local binaries), so
    # they are allowed to be empty and answer 503 rather than 502.
    map $host $origin_ollama          { default "${CLAW_OLLAMA_ORIGIN}"; }
    map $host $origin_llamacpp        { default "${CLAW_LLAMACPP_ORIGIN}"; }

    # ---- HTTP -> HTTPS redirect -------------------------------------------
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # ---- www -> apex redirect ---------------------------------------------
    #
    # MUST come before the main block: that one ends in `_`, the catch-all, so
    # without this www.<host> matches it and the whole site is served on TWO
    # hostnames. Google crawled both (www.claw-ai.co/favicon.ico and
    # /manifest.webmanifest showed up in Search Console), which splits crawl
    # budget and link signals across what is really one site.
    #
    # 301, not 302: the move is permanent, and only a permanent redirect
    # consolidates ranking signals onto the apex.
    #
    # Listens on 80 as well so http://www takes ONE hop to the canonical URL
    # rather than bouncing through the generic HTTP->HTTPS block first.
    #
    # Uses the same certificate: it already answers for www today, which is
    # exactly why www returns 200 instead of failing.
    server {
        listen 80;
        listen 443 ssl;
        http2 on;
        server_name www.${CLAW_PUBLIC_HOSTNAME};

        ssl_certificate     ${CLAW_TLS_CERT_PATH};
        ssl_certificate_key ${CLAW_TLS_KEY_PATH};

        return 301 https://${CLAW_PUBLIC_HOSTNAME}$request_uri;
    }

    # ---- Main TLS server block --------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${CLAW_PUBLIC_HOSTNAME} _;

        ssl_certificate     ${CLAW_TLS_CERT_PATH};
        ssl_certificate_key ${CLAW_TLS_KEY_PATH};

        # --- Shared proxy headers ------------------------------------------
        # Host is the UPSTREAM's hostname so managed platforms route correctly.
        # The browser's original host/proto travel in the X-Forwarded-* headers,
        # which is what the services read for absolute-URL construction.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header Origin            $http_origin;
        # X-Real-IP above is OVERWRITTEN with the socket address, so it is the
        # only client-address header a service trusts (the throttler keys on
        # it). These three would otherwise pass through as the client sent them.
        proxy_set_header CF-IPCountry      "";
        proxy_set_header CF-Connecting-IP  "";
        proxy_set_header True-Client-IP    "";

        # HTTP/1.1 keepalive to the origins; required for SSE to stream.
        proxy_http_version 1.1;

        # --- Edge policy (ADR-232) -------------------------------------------------
        # The verdicts, zones and maps live in nginx.conf (BEGIN claw-edge-policy).
        #
        # A request that CLAIMS to be a crawler whose operator publishes an IP range file, from an address
        # outside those ranges, is a fake: refused, and logged with verdict=fake for fail2ban (24 h ban).
        if ($claw_crawler_verdict = fake) { return 403; }

        # Scanner probes (/.env, /.git/config, /docker-compose.yml, traversal, *.php ...) get a tiny 404 from
        # nginx itself instead of a ~470 KB Next.js 404 page. They are still logged: fail2ban reads them.
        if ($claw_scanner_probe) { return 404; }

        # Per-address budgets for everything that has no zone of its own. A location with its own limit_req
        # stops inheriting these, so each of those repeats claw_general and claw_crawler
        # (tools/__tests__/nginx-edge-policy.test.mjs enforces it).
        limit_req zone=claw_general burst=400 nodelay;
        limit_req zone=claw_static burst=1000 nodelay;
        limit_req zone=claw_crawler burst=150 nodelay;

        # One 429 shape for every nginx-made refusal. The frontend location replaces error pages
        # (proxy_intercept_errors) and so repeats this line.
        error_page 429 @claw_429;

        # The answer to every 429 nginx makes itself (limit_req, limit_conn): JSON, never cached, and a
        # Retry-After (10 s, 120 s for a verified crawler). A service keeps answering its own 429
        # (code RATE_LIMITED + Retry-After) untouched: nothing here intercepts an upstream error.
        location @claw_429 {
            default_type application/json;
            add_header Retry-After $claw_retry_after always;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            return 429 '{"statusCode":429,"code":"EDGE_RATE_LIMITED","message":"Too many requests. Please slow down and try again shortly."}';
        }

        # --- Auth Service ---
        location /api/v1/auth {
            set $backend https://$origin_auth;
            proxy_pass $backend;
            client_max_body_size 256k;
            limit_req zone=auth_routes burst=30 nodelay;
            limit_req zone=claw_general burst=400 nodelay;
            limit_req zone=claw_crawler burst=150 nodelay;
        }

        location = /api/v1/auth/register {
            set $backend https://$origin_auth;
            proxy_pass $backend;
            client_max_body_size 64k;
            limit_req zone=auth_signup burst=3 nodelay;
            limit_req zone=auth_routes burst=30 nodelay;
            limit_req zone=claw_general burst=400 nodelay;
            limit_req zone=claw_crawler burst=150 nodelay;
        }

        location = /api/v1/auth/login {
            set $backend https://$origin_auth;

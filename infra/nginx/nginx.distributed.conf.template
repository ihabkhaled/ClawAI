        # --- Llamacpp Service: catalog / pull / models / hardware / runtime / health ---
        location /api/v1/llamacpp/ {
            if ($origin_llamacpp = "") { return 503 '{"error":"llamacpp-service is a local-runtime service and has no remote origin"}'; }
            set $backend https://$origin_llamacpp;
            rewrite ^/api/v1/llamacpp(/.*)$ /api/v1$1 break;
            proxy_pass $backend;
        }

        # --- Health Service ---
        location /api/v1/health {
            set $backend https://$origin_health;
            proxy_pass $backend;
        }

        # --- Edge health check ---
        # Answers without touching any origin, so a load balancer can tell
        # "nginx is up" apart from "the services are up".
        location = /_nginx/health {
            access_log off;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Type application/json always;
            return 200 '{"status":"ok","role":"edge"}';
        }

        # --- Frontend ---
        # Catch-all: everything that isn't /api/v1/* goes to the frontend.
        # Declared LAST so longest-prefix match picks the API routes first.
        location / {
            set $backend https://$origin_frontend;
            proxy_pass $backend;
            # Any proxy_set_header here drops every inherited one, so the shared
            # client-address headers are restated. Without X-Real-IP the throttler
            # would count every visitor of this route as one (rules/08 §Rate limiting).
            proxy_set_header Host              $proxy_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $host;
            proxy_set_header X-Request-ID      $request_id;
            proxy_set_header Origin            $http_origin;
            proxy_set_header CF-IPCountry      "";
            proxy_set_header CF-Connecting-IP  "";
            proxy_set_header True-Client-IP    "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400;
        }
    }
}

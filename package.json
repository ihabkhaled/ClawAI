{
  "name": "claw",
  "version": "0.2.0",
  "private": true,
  "description": "Claw — Local-first AI orchestration platform (microservices)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=claw-frontend",
    "build:frontend": "npm run build --workspace=claw-frontend",
    "lint:frontend": "npm run lint --workspace=claw-frontend",
    "test:frontend": "npm run test --workspace=claw-frontend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:up:full": "docker compose --profile local-ai up -d",
    "docker:up:gpu": "docker compose --profile gpu up -d",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "prepare": "node .husky/install.mjs",
    "lint-staged": "lint-staged"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@typescript/native-preview": "^7.0.0-dev.20260601.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.1",
    "prisma": "^7.8.0",
    "vitest": "^4.1.8",
    "typescript-eslint": "^8.60.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-import-x": "^4.3.0",
    "@eslint/js": "^9.39.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.18",
    "better-sqlite3": "^12.10.0",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "follow-redirects": "^1.16.0",
    "postcss": "^8.5.13",
    "fast-uri": "^3.1.2",
    "@angular-devkit/core": {
      "rxjs": "^7.8.2"
    },
    "@nestjs/schematics": {
      "typescript": "^6.0.0-beta"
    },
    "@prisma/client": {
      "typescript": "*"
    },
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "pino": "^10.3.1",
    "mongoose": "^9.6.3",
    "@hono/node-server": "^1.19.13"
  }
}
